<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the app and its modules share: the applet interface, translations (Loc, {l:Tr}), settings storage, the
       logs, theming, and the hotkey, chart and CSV code more than one module uses. Kept small, as every app carries it
       (a one-tool app too); shared code that needs packages (audio, hardware, Voicemeeter) is in DaisysApp.Shared, which
       only the modules using it bring. -->
  <PropertyGroup>
    <AssemblyName>DaisysApp.Core</AssemblyName>
    <RootNamespace>DaisysApp</RootNamespace>
    <!-- Core's API version, kept apart from the release number so a module rebuilt for a later release still loads in
         an app installed earlier (a module asks for this version of Core, and .NET won't load it against an older
         one). Raise it only when Core gains or changes something modules use; the file version still follows
         <Version>. -->
    <!-- 0.22: AppletGroup, SubTabs and IApplet.SetupPage; 0.23: [Applet(InSettings)], LineGraph.AxisFormat, GraphSeries.Bold;
         0.24: IApplet.SetupRequired; 0.25 (1.1.68): [Applet(Group)], [TabGroup], AppletGroup.AddTool, AppPaths from the
         program's name, and the audio, hardware and Voicemeeter code moved out to DaisysApp.Shared; 0.28 (3.0.0): Shell/RemoteChannels; 0.29 (3.0.5): Shell/QuickButtons; 0.30 (3.0.6): Shell/OpenFiles;
         0.33 (3.5.0): Shared/Hotkeys/Hotkeys (one registry of every shortcut), HotkeyWindow, ShortcutBox.Hotkey, Shared/ConfirmButton;
         0.34 (3.5.1): Shared/Widgets/Widget (every widget window); 0.38 (3.12.9): Log.Clear, ControllerButtons.JoystickApi;
         0.39 (3.13.0): TitleBadges.Badge.Open (a bubble opens its module), "Module/SubTab" in AppNavigation.OpenTab;
         0.40 (3.16.1): TitleBadges.Badge.Clicked, TitleBadges.Clear(prefix) -->
    <AssemblyVersion>0.40.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vortice (Mini Mirror, Performance) needs this newer System.Text.Json; the app ships it so every module gets the
         same one (two versions can't be loaded side by side) -->
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
  </ItemGroup>

</Project>
