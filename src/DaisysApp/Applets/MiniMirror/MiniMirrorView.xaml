<UserControl x:Class="DaisysApp.Applets.MiniMirror.MiniMirrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hk="clr-namespace:DaisysApp.Shared.Hotkeys">

    <UserControl.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="MirrorRow" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="10,8" Margin="0,0,0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: the mirrors -->
        <Border Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="NewButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="New_Click"
                            ToolTip="Drag around any part of the screen to mirror it">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Margin="0,0,6,0"/>
                            <TextBlock Text="New mirror" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Mirrors" Style="{StaticResource CardHeader}" Margin="0"/>
                        <TextBlock x:Name="CountText" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryText}" Margin="10,20,10,0" TextAlignment="Center" TextWrapping="Wrap"
                               Text="No mirrors yet. Press New mirror and drag around part of the screen — a track map, a delta bar, part of a HUD — to show it live in its own window you can put anywhere."/>
                    <ListBox x:Name="MirrorList" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource TextBrush}"
                             ItemContainerStyle="{StaticResource MirrorRow}" SelectionChanged="MirrorList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource ControlBorderBrush}" ToolTip="Hidden"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Visible}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                        <Setter TargetName="Dot" Property="ToolTip" Value="Showing"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <StackPanel x:Name="AllButtons" Orientation="Horizontal">
                        <Button Click="ShowAll_Click" Margin="0,0,6,0">Show all</Button>
                        <Button Click="HideAll_Click">Hide all</Button>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" Text="Ready."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: the selected mirror -->
        <Border x:Name="NoSelection" Grid.Column="2" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="How it works" Style="{StaticResource CardHeader}"/>
                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" LineHeight="20">
                    1. Press <Run FontWeight="SemiBold">New mirror</Run>, or the new-mirror shortcut (Ctrl+Shift+F8 unless you changed it in Settings) to stay in your game; the screens dim. Drag around what you want to mirror — it can span monitors. Press R or C first to switch between a rectangle and a circle.<LineBreak/>
                    2. Adjust the outline if you need to, then press <Run FontWeight="SemiBold">Confirm</Run> (or Enter).<LineBreak/>
                    3. The mirror appears on top of everything. Drag it wherever you want it and drag an edge or corner to resize it. Hold Alt while dragging to line it up with other mirrors.<LineBreak/>
                    4. Pick a mirror on the left to change its zoom, opacity, frame rate or shortcut.
                </TextBlock>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Editor" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel Margin="0,0,6,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Click="Reselect_Click" Margin="0,0,6,0" ToolTip="Drag around a new region for this mirror">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7A8;" Style="{StaticResource Glyph}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Re-select region" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Duplicate_Click" Margin="0,0,6,0" ToolTip="Copy this mirror and all its settings (except the shortcut)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Duplicate" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteButton" Click="Delete_Click" MinWidth="96">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="DeleteText" Text="Delete" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBox x:Name="NameBox" FontSize="15" VerticalAlignment="Center" LostKeyboardFocus="NameBox_LostKeyboardFocus" KeyDown="NameBox_KeyDown"/>
                        </DockPanel>
                        <TextBlock x:Name="RegionText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Display" Style="{StaticResource CardHeader}"/>
                        <CheckBox x:Name="VisibleBox" Content="Show this mirror" Checked="VisibleBox_Changed" Unchecked="VisibleBox_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <TextBlock Text="Shape" Style="{StaticResource FieldLabel}" Width="110"/>
                            <RadioButton x:Name="RectangleRadio" GroupName="Shape" Content="Rectangle" Margin="0,0,18,0" Checked="Shape_Checked"/>
                            <RadioButton x:Name="CircleRadio" GroupName="Shape" Content="Circle" Checked="Shape_Checked"/>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Window size" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SizeSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="-3.32" Maximum="2.32"
                                    ValueChanged="SizeSlider_ValueChanged" MouseDoubleClick="SizeSlider_MouseDoubleClick"
                                    ToolTip="How big the window is compared with the region it mirrors. Double-click for 1×."/>
                            <TextBlock x:Name="SizeText" Grid.Column="2" Style="{StaticResource ValueText}"/>

                            <TextBlock Grid.Row="1" Text="Zoom" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="ZoomSlider" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Minimum="-2.32" Maximum="3"
                                    ValueChanged="ZoomSlider_ValueChanged" MouseDoubleClick="ZoomSlider_MouseDoubleClick"
                                    ToolTip="Zoom in to magnify the middle of the region, or out to take in more around it. The window stays the same size. Double-click for 1×."/>
                            <TextBlock x:Name="ZoomText" Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}"/>

                            <TextBlock Grid.Row="2" Text="Opacity" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="OpacitySlider" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Minimum="10" Maximum="100"
                                    SmallChange="5" LargeChange="10" ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="OpacityText" Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}"/>

                            <TextBlock Grid.Row="3" Text="Frame rate" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="FpsSlider" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Minimum="5" Maximum="240"
                                    SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="FpsSlider_ValueChanged"
                                    ToolTip="New mirrors start at the refresh rate of their monitor. Lower it to save CPU."/>
                            <TextBlock x:Name="FpsText" Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Window" Style="{StaticResource CardHeader}"/>
                        <CheckBox x:Name="LockBox" Content="Lock position so it can't be moved or resized by accident" Checked="Behaviour_Changed" Unchecked="Behaviour_Changed"/>
                        <CheckBox x:Name="ClickThroughBox" Content="Click-through: clicks go to whatever is underneath" Margin="0,10,0,0" Checked="Behaviour_Changed" Unchecked="Behaviour_Changed"/>
                        <CheckBox x:Name="AspectBox" Content="Keep proportions when resizing from a corner" Margin="0,10,0,0" Checked="Behaviour_Changed" Unchecked="Behaviour_Changed"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Drag the mirror to move it and drag an edge or corner to resize it. Hold Alt while dragging to snap its edges to other mirrors."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Show / hide shortcut" Style="{StaticResource CardHeader}"/>
                        <hk:ShortcutBox x:Name="Shortcut" AllowControllerButtons="True" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="A key combination or a button on a wheel, button box or controller. It works while you're in a game. Mirrors that share a shortcut show and hide together."/>
                        <TextBlock x:Name="ShortcutWarning" Foreground="{DynamicResource ErrorTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
