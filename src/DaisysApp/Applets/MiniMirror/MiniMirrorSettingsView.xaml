<UserControl x:Class="DaisysApp.Applets.MiniMirror.MiniMirrorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Screen capture" Style="{StaticResource CardHeader}"/>
                <CheckBox x:Name="HideBox" Content="Hide mirrors from screenshots, recordings and streams"
                          Checked="HideBox_Changed" Unchecked="HideBox_Changed"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="26,6,0,0" TextWrapping="Wrap"
                           Text="Also stops a mirror that sits on top of the area it mirrors from showing itself over and over. Leave this off if you want mirrors to appear when you stream or record the whole screen (e.g. OBS display capture)."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Import" Style="{StaticResource CardHeader}"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SimHubButton" Click="ImportSimHub_Click">Import mirrors from the SimHub plugin</Button>
                </StackPanel>
                <TextBlock x:Name="ImportText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
