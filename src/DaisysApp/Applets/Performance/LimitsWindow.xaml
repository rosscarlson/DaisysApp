<Window x:Class="DaisysApp.Applets.Performance.LimitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp"
        Title="{l:Tr 'Warnings'}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="IntroText" Style="{StaticResource SecondaryText}" Margin="0,6,0,14" TextWrapping="Wrap"/>

        <Border Style="{StaticResource Card}" Margin="0">
            <Grid x:Name="LimitGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>

        <Border x:Name="RefreshCard" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
            <DockPanel>
                <ComboBox x:Name="RefreshBox" DockPanel.Dock="Right" Width="120"/>
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Refresh the list every'}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="{l:Tr 'While the Performance tab is showing; every 10 seconds otherwise.'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Cancel'}" MinWidth="90" IsCancel="True" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Save'}" MinWidth="90" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click"/>
            <Button Content="{l:Tr 'Reset to defaults'}" HorizontalAlignment="Left" Click="Reset_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
