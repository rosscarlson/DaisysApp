<Window x:Class="DaisysApp.Applets.Performance.SpeedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp"
        Title="{l:Tr 'Speed Test'}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{l:Tr 'Speed Test'}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,14" TextWrapping="Wrap"
                   Text="{l:Tr 'Downloads and then uploads as fast as your connection allows, using the nearest speedtest.net server (or Cloudflare\'s, if none answers). Run now on the card runs one any time.'}"/>

        <Border Style="{StaticResource Card}" Margin="0">
            <StackPanel>
                <TextBlock Text="{l:Tr 'Schedule'}" Style="{StaticResource CardHeader}"/>
                <CheckBox x:Name="ScheduleBox" Content="{l:Tr 'Run a speed test on a schedule'}" Checked="Changed" Unchecked="Changed"/>
                <Grid Margin="26,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr 'Every'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="IntervalBox" Grid.Column="1" SelectionChanged="Changed"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{l:Tr 'Test length'}" Style="{StaticResource CardHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr 'Test for'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="LengthBox" Grid.Column="1" SelectionChanged="Changed"/>
                    <TextBlock Grid.Column="2" Text="{l:Tr 'each way'}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
                <TextBlock x:Name="LengthText" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{l:Tr 'Warnings'}" Style="{StaticResource CardHeader}"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="{l:Tr 'The card turns orange or red when the latest result is slower than these (0 turns one off). A test that fails is always red.'}"/>
                <Grid x:Name="LevelGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Cancel'}" MinWidth="90" IsCancel="True" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Save'}" MinWidth="90" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click"/>
            <Button Content="{l:Tr 'Reset'}" MinWidth="90" Click="Reset_Click" HorizontalAlignment="Left" ToolTip="{l:Tr 'Back to the default settings'}"/>
        </DockPanel>
    </StackPanel>
</Window>
