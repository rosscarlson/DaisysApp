<Window x:Class="DaisysApp.Applets.Performance.NetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Tests" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Network Tests" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,14" TextWrapping="Wrap"
                   Text="Each host is pinged once a second while Daisy's App runs, and its response time graphed. Your router shows how your own network is doing; a server out on the internet shows your connection to it."/>

        <Border Style="{StaticResource Card}" Margin="0">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource SecondaryText}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="IP address or hostname" Style="{StaticResource SecondaryText}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                </Grid>
                <ItemsControl x:Name="HostList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="What to call it (optional)"/>
                                <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="e.g. 192.168.1.1, 1.1.1.1 or www.example.com"/>
                                <Button Grid.Column="2" Margin="6,0,0,0" Padding="6,3" Click="Remove_Click" ToolTip="Remove this host"
                                        AutomationProperties.Name="Remove">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Click="Add_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Add host" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RouterButton" Click="Router_Click" Content="Add my router"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="90" IsCancel="True" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Save" MinWidth="90" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click"/>
            <Border/>
        </DockPanel>
    </StackPanel>
</Window>
