<Window x:Class="DaisysApp.Applets.Performance.SensorSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="More sensor data" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <Style x:Key="Step" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style x:Key="Number" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Get more sensor data" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                   Text="Windows only lets programs read the CPU's, motherboard's, memory's and drives' sensors through a hardware driver. LibreHardwareMonitor is a free, open-source monitor with that driver; while it runs, Daisy's App reads its numbers and adds:"/>
        <TextBlock Margin="12,10,0,0" TextWrapping="Wrap" LineHeight="21">
            • CPU temperature and power on the Temperatures tile, and in the log<LineBreak/>
            • Motherboard, memory, drive and GPU hot-spot temperatures<LineBreak/>
            • Fan speeds, voltages, power, clocks and more in a Hardware sensors section
        </TextBlock>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <DockPanel>
                    <Border Style="{StaticResource Number}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold"/></Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Step}" Text="Download LibreHardwareMonitor (the .zip from the latest release)."/>
                        <Button HorizontalAlignment="Left" Click="Download_Click" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Open the download page" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <Border Style="{StaticResource Number}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold"/></Border>
                    <TextBlock Style="{StaticResource Step}" Text="Unzip it to a folder it can stay in, and run LibreHardwareMonitor.exe. Windows asks for administrator approval: it needs that to read the sensors."/>
                </DockPanel>
                <DockPanel>
                    <Border Style="{StaticResource Number}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold"/></Border>
                    <TextBlock Style="{StaticResource Step}">
                        In LibreHardwareMonitor: <Run FontWeight="SemiBold">Options → Remote Web Server → Run</Run>. It uses port 8085; if you change it, set the same address in Settings → Performance.
                    </TextBlock>
                </DockPanel>
                <DockPanel>
                    <Border Style="{StaticResource Number}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold"/></Border>
                    <TextBlock Style="{StaticResource Step}" Margin="0">
                        So it's always there: <Run FontWeight="SemiBold">Options → Run On Windows Startup</Run>, <Run FontWeight="SemiBold">Start Minimized</Run> and <Run FontWeight="SemiBold">Minimize To Tray</Run>.
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Content="Close" MinWidth="90" Click="Close_Click" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="Check again" MinWidth="110" Margin="0,0,8,0" Click="Check_Click"/>
            <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0" Fill="{DynamicResource ControlBorderBrush}"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,12,0"/>
        </DockPanel>
    </StackPanel>
</Window>
