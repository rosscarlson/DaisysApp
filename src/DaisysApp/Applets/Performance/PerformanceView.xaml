<UserControl x:Class="DaisysApp.Applets.Performance.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- nine columns beside the side cards: tighter padding than the shared table style -->
        <Style x:Key="TightCell" TargetType="DataGridCell" BasedOn="{StaticResource EventGridCell}">
            <Setter Property="Padding" Value="6,6"/>
        </Style>
        <Style x:Key="CenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource EventGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,8"/>
        </Style>
        <Style x:Key="RightHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource EventGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,8,6,8"/>
        </Style>
        <!-- processes over an orange / red level (Performance → gear) -->
        <Style x:Key="ProcessRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource EventGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="1">
                    <Setter Property="Background" Value="#38F7A541"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="2">
                    <Setter Property="Background" Value="#48F0524C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="Margin" Value="0,0,12,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
            <!-- shown while LibreHardwareMonitor isn't answering -->
            <Border x:Name="SensorBanner" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="MoreData_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Get more sensor data…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="SensorBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                               Text="CPU, motherboard, memory and drive temperatures, fan speeds, voltages and power need LibreHardwareMonitor."/>
                </DockPanel>
            </Border>

            <!-- at a glance: built in code, one tile per metric group; click a tile for its history -->
            <UniformGrid x:Name="Tiles" Columns="4" Margin="-6,0,-6,0"/>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="200" TextChanged="SearchBox_TextChanged"
                                     ToolTip="Show only processes whose name contains this"/>
                            <TextBlock DockPanel.Dock="Right" Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button DockPanel.Dock="Right" Click="ProcessSettings_Click" Padding="8,4" Margin="0,0,12,0"
                                    ToolTip="Process warnings (when a row turns orange or red) and how often the list refreshes">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Processes" Style="{StaticResource CardHeader}" Margin="0"/>
                                <TextBlock x:Name="ProcessCount" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Apps (programs with a window) first, then background processes, like Task Manager. Orange and red rows are over a warning level (the gear sets them, and the refresh rate). Double-click a process for its graphs. CPU is a share of the whole processor; RAM is private working set; GPU engine is the graphics card and engine it's using most; disk is all file, network and device I/O."/>
                        <DataGrid x:Name="ProcessGrid" Height="430" BorderThickness="0" IsReadOnly="True" HorizontalScrollBarVisibility="Auto"
                                  RowStyle="{StaticResource ProcessRowStyle}" CellStyle="{StaticResource TightCell}" MouseDoubleClick="ProcessGrid_MouseDoubleClick"
                                  EnableRowVirtualization="True" Sorting="ProcessGrid_Sorting"
                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <!-- each group's rows indented under its heading -->
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <ContentPresenter/>
                                                            <ItemsPresenter Margin="10,0,0,0"/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="10,12,0,6" FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="100"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="58" MinWidth="54" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu, StringFormat={}{0:0.0} %}" Width="62" MinWidth="58" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="RAM" Binding="{Binding MemoryMB, StringFormat={}{0:#,0} MB}" Width="76" MinWidth="72" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="GPU" Binding="{Binding Gpu, StringFormat={}{0:0.0} %}" Width="60" MinWidth="56" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="GPU engine" Binding="{Binding GpuEngine}" Width="96" MinWidth="86" HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding GpuName}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="VRAM" Binding="{Binding VramMB, StringFormat={}{0:#,0} MB}" Width="76" MinWidth="70" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="Disk" Binding="{Binding IoMBps, StringFormat={}{0:0.0} MB/s}" Width="78" MinWidth="74" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="70" MinWidth="66" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource RightHeader}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Storage" Style="{StaticResource CardHeader}"/>
                            <ItemsControl x:Name="DriveList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Free}" Style="{StaticResource SecondaryText}" FontSize="12.5"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <Border Height="8" CornerRadius="4" Margin="0,6,0,0" Background="{DynamicResource ControlBorderBrush}" ClipToBounds="True">
                                                <Border CornerRadius="4" Background="{Binding BarBrush}" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Used}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="System" Style="{StaticResource CardHeader}"/>
                            <Grid x:Name="InfoGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- every sensor LibreHardwareMonitor reports, grouped by hardware (built in code) -->
            <Border x:Name="SensorCard" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                   Text="from LibreHardwareMonitor · min and max since it started"/>
                        <TextBlock Text="Hardware sensors" Style="{StaticResource CardHeader}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel x:Name="SensorFilters" Margin="0,0,0,12"/>
                    <WrapPanel x:Name="SensorGroups"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Click a sensor for its graph, or a hardware name for all of its sensors of this kind together. Temperatures, fans and power are kept in the log; the others are live only."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
