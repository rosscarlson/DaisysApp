<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app itself: window, tabs, Settings, tray, updates. The applets are modules it loads at runtime from
       modules\ (src/Modules); shared code is in DaisysApp.Core. Common settings are in src/Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DaisysApp</AssemblyName>
    <RootNamespace>DaisysApp</RootNamespace>
    <AssemblyTitle>Daisy's App</AssemblyTitle>
    <ApplicationIcon>Assets\DaisysApp.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness is declared in app.manifest (WPF); the WinForms analyzer would rather own it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DaisysApp.Core\DaisysApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DaisysApp.ico" />
  </ItemGroup>

  <!-- The main window's translations (see Loc), as loose files next to the exe so they can be edited and added to;
       each module brings its own. -->
  <ItemGroup>
    <None Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- WinForms is only used for the tray icon; keep its namespaces out of the global usings (WPF name clashes). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
