<UserControl x:Class="DaisysApp.Shell.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sub-tabs: General, then one per module that has settings, in tab order, then the modules shown here (none now) -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel x:Name="SubTabButtons" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- the whole width; each page scrolls by itself (code-behind), except one that fills its space (Logs) -->
        <Grid x:Name="SubTabPages" Grid.Row="1"/>

        <!-- General: moved into SubTabPages as the first sub-tab by the code-behind -->
        <StackPanel x:Name="GeneralPanel" Grid.Row="1">
            <!-- side by side: Startup and System Tray, Updates, Settings -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Startup and System Tray'}" Style="{StaticResource CardHeader}"/>
                        <CheckBox x:Name="TrayBox" Content="{l:Tr 'Keep running in the system tray when the window is closed'}"
                                  Checked="TrayBox_Changed" Unchecked="TrayBox_Changed"/>
                        <CheckBox x:Name="StartupBox" Margin="0,14,0,9" Content="{l:Tr 'Start when I sign in to Windows'}"
                                  Checked="StartupBox_Changed" Unchecked="StartupBox_Changed"/>
                        <CheckBox x:Name="StartHiddenBox" Margin="26,0,0,0" Content="{l:Tr 'Start hidden in the system tray'}"
                                  Checked="StartHiddenBox_Changed" Unchecked="StartHiddenBox_Changed"/>
                        <TextBlock x:Name="StartupError" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ErrorTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="CheckNowButton" DockPanel.Dock="Right" Click="CheckNow_Click" Padding="10,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{l:Tr 'Check for updates'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Content="{l:Tr 'Release notes'}" Margin="0,0,8,0" Click="Releases_Click"/>
                            <TextBlock Text="{l:Tr 'Updates'}" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="VersionText" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <CheckBox x:Name="AutoUpdateBox" Content="{l:Tr 'Check for updates when the app starts'}"
                                  Checked="AutoUpdateBox_Changed" Unchecked="AutoUpdateBox_Changed"/>
                    </StackPanel>
                </Border>
                <!-- every module's settings in one file, and back (Shell/SettingsBackup) -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Settings'}" Style="{StaticResource CardHeader}"/>
                        <Button x:Name="SaveSettingsButton" Click="SaveSettings_Click" Padding="10,3" HorizontalAlignment="Stretch"
                                ToolTip="{l:Tr 'Save every setting of the app and its modules to one file'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:Tr 'Save…'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="LoadSettingsButton" Click="LoadSettings_Click" Padding="10,3" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                ToolTip="{l:Tr 'Replace every setting with a saved file, then restart'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:Tr 'Load…'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="ModulesCard" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{l:Tr 'Run the setup wizard…'}" Click="RunSetup_Click" Padding="12,4" VerticalAlignment="Top"
                                ToolTip="{l:Tr 'Pick the tools you want and the order of their tabs'}"/>
                        <!-- the wrapper: download more tools, or remove some -->
                        <Button x:Name="ToolsButton" DockPanel.Dock="Right" Content="{l:Tr 'Add or remove tools…'}" Click="Tools_Click" Padding="12,4" Margin="0,0,8,0"
                                VerticalAlignment="Top" Visibility="Collapsed" ToolTip="{l:Tr 'Choose which tools are downloaded'}"/>
                        <TextBlock Text="{l:Tr 'Modules'}" Style="{StaticResource CardHeader}"/>
                    </DockPanel>
                    <!-- a row per module (its tab), with its sub-modules under it: SettingsPage.Modules.cs -->
                    <StackPanel x:Name="ModuleList"/>
                    <DockPanel x:Name="RestartRow" Visibility="Collapsed" Margin="0,2,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:Tr 'Restart now'}" Click="RestartNow_Click"/>
                        <TextBlock Text="{l:Tr 'Restart the app to apply the change.'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- side by side: Appearance, Notifications, Language -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Appearance'}" Style="{StaticResource CardHeader}"/>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{l:Tr 'Theme'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ThemeBox" Width="140" SelectionChanged="ThemeBox_SelectionChanged">
                                <ComboBoxItem Content="{l:Tr 'Dark'}"/>
                                <ComboBoxItem Content="{l:Tr 'Light'}"/>
                                <ComboBoxItem Content="{l:Tr 'System'}"/>
                            </ComboBox>
                        </DockPanel>
                        <CheckBox x:Name="SoftwareBox" Margin="0,12,0,0" Content="{l:Tr 'Draw without the graphics card'}"
                                  Checked="SoftwareBox_Changed" Unchecked="SoftwareBox_Changed"/>
                        <DockPanel x:Name="SoftwareRestartRow" Visibility="Collapsed" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:Tr 'Restart now'}" Click="RestartNow_Click"/>
                            <TextBlock Text="{l:Tr 'Restart the app to apply the change.'}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Notifications'}" Style="{StaticResource CardHeader}"/>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{l:Tr 'Close the notification bar after'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="NotificationBox" Width="140" SelectionChanged="NotificationBox_SelectionChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Language'}" Style="{StaticResource CardHeader}"/>
                        <WrapPanel>
                            <TextBlock Text="{l:Tr 'Language'}" VerticalAlignment="Center" Margin="0,0,10,4"/>
                            <ComboBox x:Name="LanguageBox" Width="160" Margin="0,0,10,4" SelectionChanged="LanguageBox_SelectionChanged"/>
                            <Button Content="{l:Tr 'Translation files'}" Margin="0,0,0,4" Click="OpenLanguageFolder_Click"
                                    ToolTip="{l:Tr 'Open the folder with the app\'s modules; each has a lang folder with its translations'}"/>
                        </WrapPanel>
                        <DockPanel x:Name="LanguageRestartRow" Visibility="Collapsed" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:Tr 'Restart now'}" Click="RestartNow_Click"/>
                            <TextBlock Text="{l:Tr 'Restart the app to change the language.'}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- what's kept on disk, and cleaning it up (Shell/Storage.cs) -->
            <Border x:Name="StorageCard" Style="{StaticResource Card}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Files'}" Style="{StaticResource CardHeader}"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{l:Tr 'Open'}" Margin="10,0,0,0" MinWidth="64" Click="OpenSettingsFolder_Click"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr 'Settings'}"/>
                            <TextBlock x:Name="SettingsFolderText" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{l:Tr 'Open'}" Margin="10,0,0,0" MinWidth="64" Click="OpenLogFolder_Click"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr 'Logs'}"/>
                            <TextBlock x:Name="LogFolderText" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{l:Tr 'View'}" Margin="10,0,0,0" MinWidth="64" Click="ViewLog_Click"
                                ToolTip="{l:Tr 'Opens Logs, the last page here, or today\'s log in Notepad if Logs is switched off'}"/>
                        <ComboBox DockPanel.Dock="Right" x:Name="LogLevelBox" Width="120" VerticalAlignment="Center" SelectionChanged="LogLevelBox_SelectionChanged">
                            <ComboBoxItem Content="{l:Tr 'Normal'}"/>
                            <ComboBoxItem Content="{l:Tr 'Debug'}"/>
                        </ComboBox>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{l:Tr 'Logging'}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
