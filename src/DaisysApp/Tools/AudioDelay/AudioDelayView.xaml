<UserControl x:Class="DaisysApp.Tools.AudioDelay.AudioDelayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DaisysApp.Tools.AudioLevel.Voicemeeter">

    <UserControl.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="362"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <vm:VoicemeeterBanner x:Name="VmBanner" Grid.ColumnSpan="3"/>

        <!-- Left column: devices and microphone -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" ToolTip="Refresh devices and Voicemeeter outputs" Click="RefreshButton_Click" Padding="7,3" MinHeight="26">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                            </Button>
                            <TextBlock Text="Outputs to sync" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Device 1 — the base (no delay)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="BusABox" DisplayMemberPath="Display" SelectionChanged="BusBox_SelectionChanged"/>
                        <TextBlock Text="Device 2 — gets the delay" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <ComboBox x:Name="BusBBox" DisplayMemberPath="Display" SelectionChanged="BusBox_SelectionChanged"/>
                        <TextBlock x:Name="VmStatusText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                                   Foreground="{DynamicResource ErrorTextBrush}" Visibility="Collapsed"/>

                        <TextBlock Text="Play through" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,4"/>
                        <ComboBox x:Name="PlayBox" DisplayMemberPath="Display" SelectionChanged="PlayBox_SelectionChanged"
                                  ToolTip="The Windows playback device that feeds Voicemeeter, usually Voicemeeter Input. Its strip must be routed to both outputs."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Microphone" Style="{StaticResource CardHeader}"/>
                        <ComboBox x:Name="MicBox" DisplayMemberPath="Display" SelectionChanged="MicBox_SelectionChanged"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Height="8" CornerRadius="4" Background="{DynamicResource ControlBorderBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                <Border x:Name="MicBar" CornerRadius="4" Background="{DynamicResource SuccessBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="MicBarScale" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <TextBlock x:Name="MicLevelText" Grid.Column="1" MinWidth="78" TextAlignment="Right" FontWeight="SemiBold" Text="—"/>
                        </Grid>
                        <Grid x:Name="MicGainRow" Margin="0,10,0,0"
                              ToolTip="The microphone's input volume in Windows (Sound settings → Input → Volume).">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mic level" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Slider x:Name="MicGainSlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100"
                                    SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="MicGainSlider_ValueChanged"/>
                            <TextBlock x:Name="MicGainText" Grid.Column="2" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                                   Text="Put the mic where you sit, where it can hear both outputs. For headphones, hold an earcup against the mic."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right column: results and the run -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,12">
                    <Button x:Name="ResetButton" DockPanel.Dock="Right" Content="Reset delays" Click="ResetButton_Click"
                            ToolTip="Set both outputs' delay back to 0 ms."/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Delay" Style="{StaticResource CardHeader}" Margin="0"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="Saved in Voicemeeter's output delay (0–500 ms)"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="1">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output" Style="{StaticResource ColHeader}" TextAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="Baseline" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="2" Text="Adjusting" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="3" Text="Verifying" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="4" Text="Delay" Style="{StaticResource ColHeader}"/>
                    </Grid>
                    <ItemsControl x:Name="RowList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RowBorder" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Pass1}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Pass2}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Pass3}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Delay}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                               Text="Baseline, Adjusting and Verifying show how much later each output's beep reached the mic. Device 1 keeps 0 ms and Device 2 is delayed to match; if Device 2 turns out to be the later one, they're swapped for you. Virtual outputs (B…) can be measured but not delayed."/>
                </StackPanel>

                <!-- progress -->
                <Border Grid.Row="3" Height="8" CornerRadius="4" Background="{DynamicResource ControlBorderBrush}" ClipToBounds="True" Margin="0,14,0,12">
                    <Border CornerRadius="4" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>

                <!-- status + start -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                                   Text="Plays short beeps on each output in turn · keep the room quiet · Esc cancels and puts the delays back"/>
                    </StackPanel>
                    <Button x:Name="StartButton" Grid.Column="1" Style="{StaticResource AccentButton}" MinWidth="136" MinHeight="42"
                            Margin="16,0,0,0" Click="StartButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StartIcon" FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="StartLabel" Text="Start" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
