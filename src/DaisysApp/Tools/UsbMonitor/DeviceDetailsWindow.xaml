<Window x:Class="DaisysApp.Tools.UsbMonitor.DeviceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device details" Width="640" Height="520" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="0" Margin="0">
            <DataGrid x:Name="PropertyGrid" BorderThickness="0" IsReadOnly="True" CanUserSortColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Property" Binding="{Binding Key}" Width="220"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Copy all to clipboard" Click="CopyAll_Click" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Left" Content="Copy selected row" Click="CopySelected_Click"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" MinWidth="80"/>
        </DockPanel>
    </Grid>
</Window>
