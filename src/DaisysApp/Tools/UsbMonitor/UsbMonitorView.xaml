<UserControl x:Class="DaisysApp.Tools.UsbMonitor.UsbMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="EventRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource EventGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter bar (reserved area; no filters defined yet) -->
        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10">
            <TextBlock Text="Filters — none defined yet" Style="{StaticResource SecondaryText}" IsEnabled="False"/>
        </Border>

        <!-- Event grid -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0">
            <DataGrid x:Name="EventGrid" BorderThickness="0" HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
                      RowStyle="{StaticResource EventRowStyle}"
                      MouseDoubleClick="EventGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <!-- Explicit MinWidth on every column: without it, WPF's DataGrid silently
                         compresses fixed-width columns down to an illegible ~20px floor rather
                         than showing a horizontal scrollbar when the window is narrower than the
                         columns' combined preferred width. -->
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="150" MinWidth="110"/>
                    <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="100" MinWidth="90"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="220" MinWidth="120"/>
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="130" MinWidth="100"/>
                    <DataGridTextColumn Header="VID" Binding="{Binding VendorId}" Width="60" MinWidth="50"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProductId}" Width="60" MinWidth="50"/>
                    <DataGridTextColumn Header="Revision" Binding="{Binding Revision}" Width="85" MinWidth="75"/>
                    <DataGridTextColumn Header="Serial number" Binding="{Binding SerialNumber}" Width="140" MinWidth="100"/>
                    <DataGridTextColumn Header="Device class" Binding="{Binding DeviceClass}" Width="100" MinWidth="90"/>
                    <DataGridTextColumn Header="Driver/service" Binding="{Binding Service}" Width="115" MinWidth="105"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="150" MinWidth="90"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" MinWidth="100"/>
                    <DataGridTextColumn Header="Device instance ID" Binding="{Binding InstanceId}" Width="*" MinWidth="260"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status bar -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                       Margin="12,0,0,0" Text="0 events"/>
            <TextBlock x:Name="LogPathText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</UserControl>
