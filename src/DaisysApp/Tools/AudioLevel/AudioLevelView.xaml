<UserControl x:Class="DaisysApp.Tools.AudioLevel.AudioLevelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DaisysApp.Tools.AudioLevel.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="362"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left column: device, signal, level, microphone -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" ToolTip="Refresh device lists" Click="RefreshButton_Click" Padding="7,3" MinHeight="26">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                            </Button>
                            <TextBlock Text="Output device" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ComboBox x:Name="DeviceBox" DisplayMemberPath="Display" SelectionChanged="DeviceBox_SelectionChanged"/>
                        <TextBlock x:Name="DeviceSummary" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="DeviceWarning" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" Visibility="Collapsed"
                                   Foreground="{DynamicResource ErrorTextBrush}"
                                   Text="Voicemeeter ignores Windows channel volume and its Remote API wasn't found, so the level knobs won't change what you hear on this device."/>
                        <StackPanel x:Name="VmPanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <DockPanel>
                                <ComboBox x:Name="VmBusBox" DockPanel.Dock="Right" Width="76" SelectionChanged="VmBusBox_SelectionChanged"
                                          ToolTip="The Voicemeeter output bus your speakers are connected to"/>
                                <TextBlock Text="Voicemeeter bus for speaker levels" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <Button x:Name="VmRetryButton" DockPanel.Dock="Right" Content="Retry" Padding="10,2" MinHeight="26"
                                        Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Top" Click="VmRetry_Click"/>
                                <TextBlock x:Name="VmStatusText" Style="{StaticResource SecondaryText}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                                       Text="These levels only apply while Daisy's App is running. To keep them applied, turn on the system tray and start at sign-in under Settings → General."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Test signal" Style="{StaticResource CardHeader}"/>
                        <RadioButton x:Name="SigPink" GroupName="Signal" Content="Pink noise — full range" Margin="0,0,0,9" Checked="Signal_Checked"/>
                        <RadioButton x:Name="SigPinkBand" GroupName="Signal" Content="Pink noise — 500 Hz–2 kHz (calibration band)" Margin="0,0,0,9" Checked="Signal_Checked"/>
                        <RadioButton x:Name="SigWhite" GroupName="Signal" Content="White noise" Margin="0,0,0,9" Checked="Signal_Checked"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Hz" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="SineFreqBox" DockPanel.Dock="Right" Width="76" HorizontalContentAlignment="Right"
                                     LostKeyboardFocus="SineFreqBox_LostKeyboardFocus" KeyDown="SineFreqBox_KeyDown"/>
                            <RadioButton x:Name="SigSine" GroupName="Signal" Content="Sine tone" VerticalAlignment="Center" Checked="Signal_Checked"/>
                        </DockPanel>
                        <CheckBox x:Name="LfeLowPassBox" Margin="0,14,0,0" Checked="LfeLowPass_Changed" Unchecked="LfeLowPass_Changed"
                                  Content="Low-pass the subwoofer (LFE) channel"
                                  ToolTip="Noise sent to the LFE channel is band-limited to the subwoofer range, as in standard calibration."/>
                        <Grid x:Name="LfeCutoffRow" Margin="26,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cutoff" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Slider x:Name="LfeCutoffSlider" Grid.Column="1" Margin="10,0" Minimum="30" Maximum="200"
                                    SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="LfeCutoffSlider_ValueChanged"
                                    ToolTip="Low-pass corner frequency for the subwoofer test signal (24 dB/octave). 80 Hz is the common crossover."/>
                            <TextBlock x:Name="LfeCutoffText" Grid.Column="2" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="LevelText" DockPanel.Dock="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="Signal level" Style="{StaticResource CardHeader}" Margin="0"/>
                        </DockPanel>
                        <Slider x:Name="LevelSlider" Minimum="-60" Maximum="0" SmallChange="0.5" LargeChange="1"
                                TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="LevelSlider_ValueChanged"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                                   Text="Typical: −20 dBFS RMS pink noise, each speaker set to 75 dB SPL (C-weighted, slow). Turn off Spatial sound and audio enhancements for the device."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <ToggleButton x:Name="ListenToggle" DockPanel.Dock="Right" Style="{StaticResource ChipToggle}"
                                          Checked="ListenToggle_Changed" Unchecked="ListenToggle_Changed"
                                          ToolTip="Open the microphone and show its live level. Auto-level turns this on automatically.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Listen" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <TextBlock Text="Microphone" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"
                                       ToolTip="Place the mic at the listening position, at ear height, pointing at the ceiling. Turn off mic enhancements / auto gain in Windows Sound settings."/>
                        </DockPanel>
                        <ComboBox x:Name="MicBox" DisplayMemberPath="Display" SelectionChanged="MicBox_SelectionChanged"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Height="8" CornerRadius="4" Background="{DynamicResource ControlBorderBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                <Border x:Name="MicBar" CornerRadius="4" Background="{DynamicResource SuccessBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="MicBarScale" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <TextBlock x:Name="MicLevelText" Grid.Column="1" MinWidth="78" TextAlignment="Right" FontWeight="SemiBold" Text="—"/>
                        </Grid>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock x:Name="MicDeltaText" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MicBandText" Style="{StaticResource SecondaryText}"/>
                        </DockPanel>
                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="SetRefButton" DockPanel.Dock="Left" Click="SetRefButton_Click" Padding="10,3"
                                    ToolTip="While one speaker is playing, lock its mic level as the reference. Every speaker then shows its difference (Δ) from it.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Set reference" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="RefText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right column: speaker map -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="AutoButton" Click="AutoButton_Click" Margin="0,0,6,0"
                                ToolTip="Measure the selected speakers with the microphone and set their Windows channel volumes so they all match the reference.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AutoIcon" Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="AutoLabel" Text="Auto-level" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResetTrimsButton" Content="Reset levels" Click="ResetTrimsButton_Click" Margin="0,0,14,0"
                                ToolTip="Set every channel to the level of the loudest one (undo all trims)."/>
                        <Button Content="All" Click="SelectAll_Click" Margin="0,0,6,0" MinWidth="48"/>
                        <Button Content="None" Click="SelectNone_Click" MinWidth="48"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Speakers" Style="{StaticResource CardHeader}" Margin="0"/>
                        <TextBlock x:Name="LayoutText" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,12,0,12">
                    <Grid Width="600" Height="560">
                        <Border Margin="48,40" CornerRadius="16" Background="{DynamicResource RoomBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"/>
                        <TextBlock Text="FRONT" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,96,0,0"/>

                        <Canvas>
                            <StackPanel x:Name="Listener" Canvas.Left="260" Canvas.Top="246" Width="80">
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Listener" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Canvas>

                        <ItemsControl x:Name="SpeakerItems" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="96" Height="80">
                                        <Border x:Name="Glow" Margin="-5" CornerRadius="12" BorderThickness="3"
                                                BorderBrush="{DynamicResource SuccessBrush}" Visibility="Collapsed"/>
                                        <ToggleButton Style="{StaticResource SpeakerTile}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      ToolTip="{Binding ToolTip}" MouseRightButtonUp="Speaker_MouseRightButtonUp">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Short}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="9.5" Opacity="0.8" HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="88"/>
                                                <StackPanel x:Name="ReadingRow" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed"
                                                            ToolTip="Mic level for this speaker, and its difference from the reference">
                                                    <TextBlock Text="{Binding MicText}" FontSize="10.5"/>
                                                    <TextBlock x:Name="DeltaLabel" Text="{Binding DeltaText}" FontSize="10.5" FontWeight="Bold" Margin="6,0,0,0"/>
                                                    <TextBlock x:Name="MatchMark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               VerticalAlignment="Center" Margin="3,1,0,0" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ToggleButton>
                                        <!-- Trim: knob appears when the speaker is selected -->
                                        <StackPanel x:Name="TrimRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    Margin="0,0,0,5" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                                            <controls:TrimKnob x:Name="Knob" Width="26" Height="26" Visibility="Collapsed" Margin="0,0,5,0"
                                                               Minimum="{Binding TrimMin}" Maximum="{Binding TrimMax}" Value="{Binding TrimDb, Mode=TwoWay}"
                                                               Committed="Knob_Committed"
                                                               ToolTip="Drag up/down or scroll to set this speaker's level (Shift = fine). Double-click for 0 dB."/>
                                            <TextBlock Text="{Binding TrimText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </StackPanel>
                                        <TextBlock x:Name="Wave" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,6,0"
                                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSounding}" Value="True">
                                            <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Wave" Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Pulse">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.3" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="Pulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Wave" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                            <Setter TargetName="TrimRow" Property="TextElement.Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                            <Setter TargetName="Knob" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanTrim}" Value="False">
                                            <Setter TargetName="Knob" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasReading}" Value="True">
                                            <Setter TargetName="NameText" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="ReadingRow" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                            <Setter TargetName="MatchMark" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoDeviceText" Text="No active output devices found." Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </Viewbox>

                <!-- Auto-cycle -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="CycleBox" Content="Auto-cycle selected speakers, every" VerticalAlignment="Center"
                                  Checked="CycleBox_Changed" Unchecked="CycleBox_Changed"
                                  ToolTip="Plays one selected speaker at a time, stepping to the next after the interval."/>
                        <Slider x:Name="CycleSlider" Grid.Column="1" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                SmallChange="1" LargeChange="1" Margin="12,0" VerticalAlignment="Center" MaxWidth="260"
                                HorizontalAlignment="Stretch" ValueChanged="CycleSlider_ValueChanged"/>
                        <TextBlock x:Name="CycleText" Grid.Column="2" VerticalAlignment="Center" MinWidth="28"/>
                    </Grid>
                </Border>

                <!-- Status + play -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                                   Text="Click a speaker to select it and show its level knob · right-click or keys 1–9 to solo · Space plays / stops"/>
                    </StackPanel>
                    <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource AccentButton}" MinWidth="136" MinHeight="42"
                            Margin="16,0,0,0" Click="PlayButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PlayIcon" FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="PlayLabel" Text="Play" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
