<UserControl x:Class="DaisysApp.Tools.AudioLevel.Voicemeeter.VoicemeeterBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- Shown at the top of the tools that rely on Voicemeeter, only while it's missing or not running. -->
    <Border Margin="0,0,0,12" Padding="14,8" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DangerBrush}">
        <DockPanel>
            <Button x:Name="ActionButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="ActionButton_Click"/>
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource ErrorTextBrush}"/>
            <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Border>
</UserControl>
