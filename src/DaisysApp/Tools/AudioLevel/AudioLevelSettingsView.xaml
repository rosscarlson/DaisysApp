<UserControl x:Class="DaisysApp.Tools.AudioLevel.AudioLevelSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Voicemeeter" Style="{StaticResource CardHeader}"/>
                <CheckBox x:Name="VoicemeeterBox" Content="Set speaker levels in Voicemeeter's bus EQ"
                          Checked="VoicemeeterBox_Changed" Unchecked="VoicemeeterBox_Changed"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="26,6,0,0"
                           Text="Voicemeeter ignores Windows channel volume, so for Voicemeeter output devices each speaker's level is set in the bus EQ of the bus you pick, using cells 5 and 6 of that speaker's channel as a flat volume control. Voicemeeter keeps these with its own settings, so they stay applied whether or not Daisy's App is running. Needs Voicemeeter Banana or Potato; the range is ±12 dB."/>
                <TextBlock x:Name="VoicemeeterStatus" Margin="26,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="26,6,0,0"
                           Text="Pick the bus under Output device on the Audio Leveler tab. Turning this off leaves any levels already in Voicemeeter as they are; use Reset levels first if you want them cleared."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Signal options" Style="{StaticResource CardHeader}"/>
                <TextBlock Style="{StaticResource SecondaryText}"
                           Text="The test signal, subwoofer low-pass and auto-cycle options are on the Audio Leveler tab, next to the speaker map. They're saved as you change them. Auto-level always uses band-limited pink noise."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
