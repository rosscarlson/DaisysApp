<UserControl x:Class="DaisysApp.Tools.AudioLevel.AudioLevelSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Voicemeeter" Style="{StaticResource CardHeader}"/>
                <CheckBox x:Name="VoicemeeterBox" Content="Set speaker levels inside Voicemeeter"
                          Checked="VoicemeeterBox_Changed" Unchecked="VoicemeeterBox_Changed"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="26,6,0,0"
                           Text="Voicemeeter ignores Windows channel volume, so for Voicemeeter output devices the level knobs apply a gain inside the Voicemeeter bus instead. Only one program can use the bus insert at a time; turn this off to free it for another tool, such as the 8x8 Matrix."/>
                <TextBlock x:Name="VoicemeeterStatus" Margin="26,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="26,6,0,0"
                           Text="Pick the bus under Output device on the Audio Leveler tab. The levels apply only while Daisy's App is running: see Settings → General to keep it in the system tray and start it at sign-in."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Signal options" Style="{StaticResource CardHeader}"/>
                <TextBlock Style="{StaticResource SecondaryText}"
                           Text="The test signal, signal level, subwoofer low-pass and auto-cycle options are on the Audio Leveler tab, next to the speaker map. They're saved as you change them."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
