<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game controllers through DirectInput, for every module that reads them (ForzaWheel, Button2Key, SimEffects,
       Calibration): one list of what's plugged in (made once, and again only when Refresh is pressed), one DirectInput,
       one lock. As DaisysApp.Shared, the app doesn't carry it: a module that uses it references this project and gets it
       copied into its own folder; the app loads it once, so every module shares the same list. -->
  <PropertyGroup>
    <AssemblyName>DaisysApp.Controllers</AssemblyName>
    <RootNamespace>DaisysApp.Controllers</RootNamespace>
    <!-- kept apart from the release number, as Core's is: raise it when something modules use changes -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- supplied by the app -->
    <ProjectReference Include="..\DaisysApp.Core\DaisysApp.Core.csproj" Private="false" />
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
  </ItemGroup>

</Project>
