<UserControl x:Class="DaisysApp.Applets.AudioLevels.AudioLevelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core">

    <UserControl.Resources>
        <!-- the volume number: click it for 100 -->
        <Style x:Key="MaxButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DeviceRow">
            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*" MinWidth="220"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton IsChecked="{Binding Muted, Mode=TwoWay}" ToolTip="{Binding MuteTip}" Style="{StaticResource ChipToggle}"
                                  Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MuteGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                    </ToggleButton>
                    <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}" Margin="0,0,16,0"/>
                    <Slider Grid.Column="2" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                            Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"
                            PreviewMouseWheel="Slider_PreviewMouseWheel"
                            ToolTip="{l:Tr 'Drag, or scroll (Shift = 1 at a time)'}"/>
                    <Button Grid.Column="3" Style="{StaticResource MaxButton}" Click="Max_Click" HorizontalAlignment="Right"
                            VerticalAlignment="Center" ToolTip="{l:Tr 'Click to set to 100'}" AutomationProperties.Name="Set to 100">
                        <TextBlock Text="{Binding VolumeText}" FontSize="15" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Click="Refresh_Click" Padding="8,4" ToolTip="{l:Tr 'Look for devices again'}">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                        </Button>
                        <TextBlock Text="{l:Tr 'Playback devices'}" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl x:Name="PlaybackList" ItemTemplate="{StaticResource DeviceRow}" Focusable="False"/>
                    <TextBlock x:Name="NoPlayback" Text="{l:Tr 'No playback devices are connected.'}" Style="{StaticResource SecondaryText}"
                               Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Recording devices'}" Style="{StaticResource CardHeader}"/>
                    <ItemsControl x:Name="RecordingList" ItemTemplate="{StaticResource DeviceRow}" Focusable="False"/>
                    <TextBlock x:Name="NoRecording" Text="{l:Tr 'No recording devices are connected.'}" Style="{StaticResource SecondaryText}"
                               Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SecondaryText}" Margin="4,0,0,0" TextWrapping="Wrap"
                       Text="{l:Tr 'These are the devices\' Windows volumes (the same as Sound settings). Click a speaker to mute it, or a volume\'s number to set it to 100. They update live, so if something turns a device down you\'ll see it here. Devices appear and disappear as they\'re connected.'}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
