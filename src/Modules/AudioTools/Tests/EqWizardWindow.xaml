<Window x:Class="DaisysApp.Applets.AudioTools.Tests.EqWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core"
        xmlns:controls="clr-namespace:DaisysApp.Applets.AudioTools.Tests.Controls"
        Title="{l:Tr 'EQ Wizard'}" Width="1000" MinWidth="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16,20,20">
        <TextBlock Text="{l:Tr 'EQ Wizard'}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="{l:Tr 'Measures each speaker with the microphone at the listening position and sets an EQ for that speaker that evens out its response in the room: mostly cuts for the peaks a room adds in the bass.'}"/>

        <Border Style="{StaticResource Card}" Margin="0,14,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{l:Tr 'Output'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,6"/>
                <TextBlock x:Name="OutputText" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Text="{l:Tr 'EQ saved in'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                <TextBlock x:Name="SavedInText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap"/>
                <TextBlock x:Name="WarningText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource ErrorTextBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="MicLevelText" DockPanel.Dock="Right" MinWidth="90" TextAlignment="Right" FontWeight="SemiBold" Text="—"/>
                        <TextBlock Text="{l:Tr 'Microphone'}" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ComboBox x:Name="MicBox" DisplayMemberPath="Display" Margin="0,4,0,10" SelectionChanged="MicBox_SelectionChanged"/>
                    <Border Height="8" CornerRadius="4" Background="{DynamicResource ControlBorderBrush}" ClipToBounds="True">
                        <Border x:Name="MicBar" CornerRadius="4" Background="{DynamicResource SuccessBrush}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="MicBarScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <Grid x:Name="MicGainRow" Margin="0,12,0,0"
                          ToolTip="{l:Tr 'The microphone\'s input volume in Windows (Sound settings → Input → Volume).'}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr 'Mic level'}" Style="{StaticResource Label}" Margin="0"/>
                        <Slider x:Name="MicGainSlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100"
                                SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="MicGainSlider_ValueChanged"/>
                        <TextBlock x:Name="MicGainText" Grid.Column="2" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                    <DockPanel Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="LoadCalButton" Content="{l:Tr 'Load…'}" MinWidth="64" Click="LoadCal_Click"
                                    ToolTip="{l:Tr 'Load the microphone\'s calibration file (a text file of frequency and dB).'}"/>
                            <Button x:Name="ClearCalButton" Content="{l:Tr 'Clear'}" MinWidth="56" Margin="6,0,0,0" Click="ClearCal_Click"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{l:Tr 'Calibration file'}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CalText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Options'}" Style="{StaticResource CardHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:Tr 'Target'}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="TargetBox" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="{l:Tr 'Room curve (fuller bass, softer treble, recommended)'}"/>
                            <ComboBoxItem Content="{l:Tr 'Flat (measures flat, but usually sounds thin in a room)'}"/>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="{l:Tr 'Correct up to'}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="RangeBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="{l:Tr '300 Hz (the bass only)'}" Tag="300"/>
                            <ComboBoxItem Content="{l:Tr '1 kHz (bass and lower mids, recommended)'}" Tag="1000"/>
                            <ComboBoxItem Content="{l:Tr '16 kHz (the full range)'}" Tag="16000"/>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="{l:Tr 'Most boost'}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="BoostBox" Grid.Row="2" Grid.Column="1" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="{l:Tr 'None (cuts only)'}" Tag="0"/>
                            <ComboBoxItem Content="{l:Tr '3 dB'}" Tag="3"/>
                            <ComboBoxItem Content="{l:Tr '6 dB'}" Tag="6"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="{l:Tr 'A room\'s dips can\'t really be filled in by boosting, so boosts are kept small. Above 1 kHz one mic position says little about what you hear, so the full range is best kept for speakers that clearly need it.'}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0" Padding="16,10">
                <StackPanel>
                    <!-- column headers; widths match the row template below -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr 'Speaker'}" Style="{StaticResource ColHeader}" TextAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="{l:Tr 'Before'}" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="2" Text="{l:Tr 'Filters'}" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="3" Text="{l:Tr 'After'}" Style="{StaticResource ColHeader}"/>
                    </Grid>
                    <ItemsControl x:Name="RowList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RowBorder" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="6,7"
                                        Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Row_Click" ToolTip="{l:Tr 'Click to show this speaker on the graph'}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Content="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BeforeText}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding FiltersText}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding AfterText}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsShown}" Value="True">
                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{l:Tr 'Before and After: how far the speaker\'s response strays from the target over the corrected range (RMS). Filters: how many EQ filters it got.'}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="11.5">
                            <Rectangle Width="14" Height="2" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{l:Tr 'Before'}" Margin="0,0,12,0"/>
                            <Rectangle Width="14" Height="2.5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{l:Tr 'After'}" Margin="0,0,12,0"/>
                            <Rectangle Width="14" Height="2" Fill="#2EAD5B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{l:Tr 'EQ'}"/>
                        </StackPanel>
                        <TextBlock x:Name="GraphTitle" Text="{l:Tr 'Response'}" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="FilterList" DockPanel.Dock="Bottom" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <controls:ResponseGraph x:Name="Graph" Height="250"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- progress + status -->
        <Border Height="8" CornerRadius="4" Background="{DynamicResource ControlBorderBrush}" ClipToBounds="True" Margin="0,0,0,10">
            <Border CornerRadius="4" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                </Border.RenderTransform>
            </Border>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                           Text="{l:Tr 'Keep the room quiet while it runs · about 15 seconds per speaker · Esc cancels and puts the EQ back'}"/>
            </StackPanel>
            <Button x:Name="ExportButton" Grid.Column="1" Content="{l:Tr 'Export diagnostics…'}" Margin="16,0,0,0" Click="ExportButton_Click"
                    ToolTip="{l:Tr 'Save a zip of the last Level and EQ Wizard runs (recordings, readings, filters) and the settings, to send in when something comes out wrong.'}"/>
            <Button x:Name="RemoveButton" Grid.Column="2" Content="{l:Tr 'Remove EQ'}" MinWidth="96" Margin="8,0,0,0" Click="RemoveButton_Click"
                    ToolTip="{l:Tr 'Remove the EQ from the ticked speakers.'}"/>
            <Button x:Name="CloseButton" Grid.Column="3" Content="{l:Tr 'Close'}" MinWidth="80" Margin="8,0,8,0" Click="CloseButton_Click"/>
            <Button x:Name="StartButton" Grid.Column="4" Style="{StaticResource AccentButton}" MinWidth="136" MinHeight="42" Click="StartButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StartIcon" FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StartLabel" Text="{l:Tr 'Start'}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
    </ScrollViewer>
</Window>
