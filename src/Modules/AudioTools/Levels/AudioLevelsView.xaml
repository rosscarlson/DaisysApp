<UserControl x:Class="DaisysApp.Applets.AudioTools.Levels.AudioLevelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core">

    <UserControl.Resources>
        <!-- the volume number (click it for 100) and the name (click it for its shortcuts): text that's a button -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="VolumeRow">
            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ToggleButton IsChecked="{Binding Muted, Mode=TwoWay}" ToolTip="{Binding MuteTip}" Style="{StaticResource ChipToggle}"
                                  Padding="7,3" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MuteGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                    </ToggleButton>
                    <Button Grid.Column="1" Style="{StaticResource TextButton}" Click="Name_Click" ToolTip="{Binding NameTip}">
                        <TextBlock Text="{Binding Display}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Grid.Column="2" Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" Margin="4,0,4,0" ToolTip="{Binding HotkeyText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHotkeys}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="3" Style="{StaticResource TextButton}" Click="Max_Click" HorizontalContentAlignment="Right"
                            VerticalAlignment="Center" ToolTip="{l:Tr 'Click to set to 100'}" AutomationProperties.Name="Set to 100">
                        <TextBlock Text="{Binding VolumeText}" FontSize="15" FontWeight="SemiBold"/>
                    </Button>
                    <Slider Grid.Row="1" Grid.ColumnSpan="4" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Margin="2,6,2,0"
                            Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"
                            PreviewMouseWheel="Slider_PreviewMouseWheel"
                            ToolTip="{l:Tr 'Drag, or scroll (Shift = 1 at a time)'}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- how much a shortcut press changes the volume is in Settings → Audio Tools -->
            <DockPanel Margin="2,0,0,10">
                <Button DockPanel.Dock="Right" Click="Refresh_Click" Padding="8,4" ToolTip="{l:Tr 'Look for devices and apps again'}" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                </Button>
                <TextBlock Text="{l:Tr 'Click a name to set its shortcuts.'}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Playback devices'}" Style="{StaticResource CardHeader}"/>
                        <ItemsControl x:Name="PlaybackList" ItemTemplate="{StaticResource VolumeRow}" Focusable="False"/>
                        <TextBlock x:Name="NoPlayback" Text="{l:Tr 'No playback devices are connected.'}" Style="{StaticResource SecondaryText}"
                                   Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Recording devices'}" Style="{StaticResource CardHeader}"/>
                        <ItemsControl x:Name="RecordingList" ItemTemplate="{StaticResource VolumeRow}" Focusable="False"/>
                        <TextBlock x:Name="NoRecording" Text="{l:Tr 'No recording devices are connected.'}" Style="{StaticResource SecondaryText}"
                                   Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Apps'}" Style="{StaticResource CardHeader}"/>
                        <ItemsControl x:Name="AppList" ItemTemplate="{StaticResource VolumeRow}" Focusable="False"/>
                        <TextBlock x:Name="NoApps" Text="{l:Tr 'No apps are playing sound. Apps appear here once they\'ve played something.'}" Style="{StaticResource SecondaryText}"
                                   Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
