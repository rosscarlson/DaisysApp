<UserControl x:Class="DaisysApp.Applets.Resizer.ResizerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="PollText" DockPanel.Dock="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Tr 'Process watcher'}" Style="{StaticResource CardHeader}" Margin="0"/>
                </DockPanel>
                <Slider x:Name="PollSlider" Minimum="250" Maximum="5000" SmallChange="250" LargeChange="250"
                        TickFrequency="250" IsSnapToTickEnabled="True" ValueChanged="PollSlider_ValueChanged"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                           Text="{l:Tr 'How often to check for newly started programs. Faster catches a game\'s window sooner; slower uses a little less CPU. Turn the watcher itself on or off on the Resizer tab.'}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l:Tr 'Import profiles'}" Style="{StaticResource CardHeader}"/>
                <TextBlock Style="{StaticResource SecondaryText}"
                           Text="{l:Tr 'Copy profiles and groups from Resize Rabbit or Resize Raccoon on this PC. Profiles you already have are skipped. Resize Rabbit\'s are imported automatically the first time the Resizer starts.'}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="RabbitButton" Content="{l:Tr 'Import from Resize Rabbit'}" Click="ImportRabbit_Click" Margin="0,0,8,0"/>
                    <Button x:Name="RaccoonButton" Content="{l:Tr 'Import from Resize Raccoon'}" Click="ImportRaccoon_Click"/>
                </StackPanel>
                <TextBlock x:Name="ImportText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l:Tr 'Using it alongside Resize Rabbit'}" Style="{StaticResource CardHeader}"/>
                <TextBlock Style="{StaticResource SecondaryText}"
                           Text="{l:Tr 'If Resize Rabbit is still running, it keeps its shortcuts and the script pipe for itself, so the Resizer can\'t use them. Once your profiles are here, close Resize Rabbit (and stop it starting with Windows) and use the Resizer instead.'}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
