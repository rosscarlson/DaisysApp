<Window x:Class="DaisysApp.Applets.Resizer.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core"
        xmlns:local="clr-namespace:DaisysApp.Applets.Resizer"
        xmlns:hk="clr-namespace:DaisysApp.Shared.Hotkeys;assembly=DaisysApp.Core"
        Title="{l:Tr 'Resizer profile'}" Width="760" MinWidth="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,20">
        <TextBlock x:Name="HeaderText" Text="{l:Tr 'New profile'}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <!-- What -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Profile name'}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="NameBox" TextChanged="Field_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Tr 'Group'}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="GroupBox" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <TextBlock Text="{l:Tr 'Program'}" Style="{StaticResource Label}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Padding="7,3" MinHeight="32" Margin="6,0,0,0" ToolTip="{l:Tr 'Refresh the list of running programs'}"
                                Click="RefreshProcesses_Click">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                        </Button>
                        <ComboBox x:Name="ProcessBox" IsEditable="True" IsTextSearchEnabled="True"
                                  TextBoxBase.TextChanged="Field_Changed"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <CheckBox x:Name="ShowAllBox" DockPanel.Dock="Right" Content="{l:Tr 'Show all processes'}"
                                  Checked="RefreshProcesses_Click" Unchecked="RefreshProcesses_Click"/>
                        <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                   Text="{l:Tr 'Pick a running program, or type its exe name (e.g. RRRE64.exe) if it isn\'t running.'}"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Where -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="{l:Tr 'Use current window'}" Click="UseCurrent_Click"
                            ToolTip="{l:Tr 'Fill in the program\'s window size and position as it is right now'}"/>
                    <ComboBox x:Name="PresetBox" DockPanel.Dock="Right" Width="210" Margin="0,0,8,0" SelectionChanged="PresetBox_SelectionChanged"
                              ToolTip="{l:Tr 'Copy values for a triple-monitor setup (center screen is the main display)'}">
                        <ComboBoxItem Content="{l:Tr 'Copy from a preset…'}" IsEnabled="False"/>
                        <ComboBoxItem Content="{l:Tr 'Triple 1080p (5760 × 1080)'}" Tag="5760,1080,-1920,0"/>
                        <ComboBoxItem Content="{l:Tr 'Triple 1440p (7680 × 1440)'}" Tag="7680,1440,-2560,0"/>
                        <ComboBoxItem Content="{l:Tr 'Triple 4K (11520 × 2160)'}" Tag="11520,2160,-3840,0"/>
                    </ComboBox>
                    <TextBlock Text="{l:Tr 'Window'}" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{l:Tr 'Width'}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="WidthBox" HorizontalContentAlignment="Right" TextChanged="Field_Changed"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{l:Tr 'Height'}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="HeightBox" HorizontalContentAlignment="Right" TextChanged="Field_Changed"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{l:Tr 'Position X'}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="XBox" HorizontalContentAlignment="Right" TextChanged="Field_Changed"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Position Y'}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="YBox" HorizontalContentAlignment="Right" TextChanged="Field_Changed"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                           Text="{l:Tr 'In pixels. Leave width and height empty to only move the window and keep its size. Position is from the top-left of the main display, so screens to its left are negative (a triple-monitor setup usually starts at minus one screen\'s width).'}"/>
                <CheckBox x:Name="BordersBox" Margin="0,12,0,0" Content="{l:Tr 'Remove borders'}"
                          Checked="Borders_Changed" Unchecked="Borders_Changed"
                          ToolTip="{l:Tr 'Strip the window\'s frame. Only needed if the game has no borderless mode of its own.'}"/>
                <CheckBox x:Name="TitlebarBox" Margin="26,8,0,0" Content="{l:Tr 'Remove title bar (Store / UWP games)'}"
                          ToolTip="{l:Tr 'For Store games like Forza Horizon 4 that still show a title bar after removing borders: moves it above the top of the screen. Does nothing for other games.'}"/>
            </StackPanel>
        </Border>

        <!-- When -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <CheckBox x:Name="AutoBox" Content="{l:Tr 'Apply automatically when the program starts'}"
                              Checked="Auto_Changed" Unchecked="Auto_Changed"/>
                    <DockPanel x:Name="DelayRow" Margin="26,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{l:Tr 'ms'}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="DelayBox" DockPanel.Dock="Right" Width="80" HorizontalContentAlignment="Right" TextChanged="Field_Changed"/>
                        <TextBlock Text="{l:Tr 'Wait after it starts'}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="26,6,0,0"
                               Text="{l:Tr 'Needs the process watcher (Resizer tab). If the window isn\'t there yet it tries again for up to 10 seconds.'}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Tr 'Shortcut'}" Style="{StaticResource Label}"/>
                    <hk:ShortcutBox x:Name="Shortcut"/>
                    <TextBlock x:Name="SharedText" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

        <DockPanel LastChildFill="False">
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Content="{l:Tr 'Delete'}" MinWidth="80" Click="Delete_Click"/>
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:Tr 'Save'}" MinWidth="100" Click="Save_Click" IsDefault="True"/>
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Cancel'}" MinWidth="80" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="TestButton" DockPanel.Dock="Right" Margin="0,0,8,0" Click="Test_Click"
                    ToolTip="{l:Tr 'Apply these values to the program\'s window now, without saving'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE740;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{l:Tr 'Apply now'}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </StackPanel>
</Window>
