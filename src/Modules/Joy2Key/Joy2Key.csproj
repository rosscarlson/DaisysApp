<Project Sdk="Microsoft.NET.Sdk">
  <!-- See ../Directory.Build.props and ../Template/README.md. Joy2Key: a module of its own (its own app too, Joy2Key.exe);
       in Daisy's App it shares the Gaming tab with ForzaWheel (GamingTab.cs). -->
  <ItemGroup>
    <!-- controllers the classic joystick API misses (all buttons, axes and hats), read as ForzaWheel reads them -->
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
    <Compile Include="..\ForzaWheel\GameControllers.cs" Link="Shared\GameControllers.cs" />
  </ItemGroup>
</Project>
