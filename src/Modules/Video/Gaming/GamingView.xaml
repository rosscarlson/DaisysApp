<UserControl x:Class="DaisysApp.Applets.Video.Gaming.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core"
             xmlns:g="clr-namespace:DaisysApp.Applets.Video.Gaming"
             xmlns:charts="clr-namespace:DaisysApp.Shared.Charts;assembly=DaisysApp.Core">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Stat" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,28,8"/>
        </Style>
        <Style x:Key="Mid" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SmallStat" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,22,4"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <!-- a card in the squares: the grid spaces them -->
        <Style x:Key="Square" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="SessionRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="8,5" Margin="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Two pages, each a sub-tab of Video (GamingView hands them out): Overlay, and Recording -->
    <Grid>
        <ScrollViewer x:Name="OverlayPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- a square each, two to a row, the whole width -->
            <g:SquareGrid Columns="2" Gap="12" Margin="0,0,10,12">

                <!-- frame counter -->
                <Border Style="{StaticResource Square}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Now'}" Style="{StaticResource CardHeader}"/>
                        <Border x:Name="PermissionPanel" Visibility="Collapsed" Background="{DynamicResource ControlBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="PermissionText" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="AllowButton" Style="{StaticResource AccentButton}" Content="{l:Tr 'Allow…'}" Click="Allow_Click" Margin="0,0,8,0"/>
                                    <Button Content="{l:Tr 'Try again'}" Click="Retry_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="GameText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource Stat}">
                                <TextBlock x:Name="FpsText" Style="{StaticResource Big}" Text="–"/>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr 'frames a second'}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Stat}">
                                <TextBlock x:Name="LowText" Style="{StaticResource Big}" Text="–"/>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr '1% low (30 s)'}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Stat}">
                                <TextBlock x:Name="FrametimeText" Style="{StaticResource Big}" Text="–"/>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr 'frame time'}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- overlay -->
                <Border Style="{StaticResource Square}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'FPS overlay'}" Style="{StaticResource CardHeader}"/>
                        <CheckBox x:Name="OverlayBox" Content="{l:Tr 'Show the overlay'}" Margin="0,0,0,12" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                        <WrapPanel Margin="0,0,0,12">
                            <TextBlock Text="{l:Tr 'Mode'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ModeBox" Width="140" SelectionChanged="Mode_Changed">
                                <ComboBoxItem Content="{l:Tr 'Simple'}"/>
                                <ComboBoxItem Content="{l:Tr 'Medium'}"/>
                                <ComboBoxItem Content="{l:Tr 'Advanced'}"/>
                            </ComboBox>
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox x:Name="LockBox" Content="{l:Tr 'Lock in place'}" VerticalAlignment="Center" Margin="0,0,24,8" Checked="Lock_Changed" Unchecked="Lock_Changed"/>
                            <Button Content="{l:Tr 'Reset position'}" Margin="0,0,0,8" Click="ResetPosition_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="OverlayHint" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </g:SquareGrid>
        </ScrollViewer>

        <ScrollViewer x:Name="RecordingPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <!-- Performance on the left, as tall as Record and Benchmark stacked on the right -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- the PC's load: its graphs share whatever height the card has -->
                    <Border Style="{StaticResource Square}" Grid.RowSpan="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="120"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="120"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:Tr 'Performance'}" Style="{StaticResource CardHeader}"/>
                            <WrapPanel Grid.Row="1">
                                <StackPanel Style="{StaticResource SmallStat}">
                                    <TextBlock x:Name="GpuText" Style="{StaticResource Mid}" Text="–"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr 'GPU'}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SmallStat}">
                                    <TextBlock x:Name="VramText" Style="{StaticResource Mid}" Text="–"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr 'video memory'}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SmallStat}">
                                    <TextBlock x:Name="CpuText" Style="{StaticResource Mid}" Text="–"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr 'CPU'}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SmallStat}">
                                    <TextBlock x:Name="RamText" Style="{StaticResource Mid}" Text="–"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr 'memory'}"/>
                                </StackPanel>
                            </WrapPanel>
                            <DockPanel Grid.Row="2" Margin="0,12,0,4">
                                <TextBlock x:Name="LoadLegend" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr 'GPU and CPU, last 2 minutes'}"/>
                            </DockPanel>
                            <Border Grid.Row="3" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                                <charts:LineGraph x:Name="LoadGraph"/>
                            </Border>
                            <DockPanel Grid.Row="4" Margin="0,10,0,4">
                                <TextBlock x:Name="MemoryLegend" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr 'Memory and video memory in use'}"/>
                            </DockPanel>
                            <Border Grid.Row="5" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                                <charts:LineGraph x:Name="MemoryGraph"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- recording -->
                    <Border Style="{StaticResource Square}" Grid.Column="2">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Record'}" Style="{StaticResource CardHeader}"/>
                            <WrapPanel Margin="0,0,0,10">
                                <RadioButton x:Name="SourceMonitor" GroupName="Source" Content="{l:Tr 'A monitor'}" Margin="0,0,18,4" Checked="Source_Changed"/>
                                <RadioButton x:Name="SourceRegion" GroupName="Source" Content="{l:Tr 'A region'}" Margin="0,0,18,4" Checked="Source_Changed"/>
                                <RadioButton x:Name="SourceApp" GroupName="Source" Content="{l:Tr 'A game or program'}" Margin="0,0,0,4" Checked="Source_Changed"/>
                            </WrapPanel>
                            <DockPanel x:Name="MonitorRow" Margin="0,0,0,10">
                                <TextBlock Text="{l:Tr 'Monitor'}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="MonitorBox" SelectionChanged="Monitor_Changed"/>
                            </DockPanel>
                            <DockPanel x:Name="RegionRow" Margin="0,0,0,10">
                                <TextBlock Text="{l:Tr 'Region'}" Style="{StaticResource Label}"/>
                                <Button Content="{l:Tr 'Select…'}" Click="SelectRegion_Click" Margin="0,0,12,0"/>
                                <TextBlock x:Name="RegionText" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel x:Name="AppRow" Margin="0,0,0,10">
                                <TextBlock Text="{l:Tr 'Program'}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="AppBox" SelectionChanged="App_Changed" DropDownOpened="AppBox_DropDownOpened"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="{l:Tr 'Quality'}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="ProfileBox" SelectionChanged="Profile_Changed"/>
                            </DockPanel>
                            <TextBlock x:Name="ProfileText" Margin="0,0,0,10" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="{l:Tr 'Shape'}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="OutputBox" SelectionChanged="Output_Changed"
                                          ToolTip="{l:Tr 'The recording\'s shape: what\'s captured, or the middle of it in a set shape (the cameras\' layout shows it)'}"/>
                            </DockPanel>
                            <TextBlock x:Name="OutputText" Margin="0,0,0,14" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button x:Name="RecordButton" Style="{StaticResource AccentButton}" MinWidth="150" Margin="0,0,8,8" Click="Record_Click"/>
                                <Button Content="{l:Tr 'Browse Folder'}" Margin="0,0,8,8" Click="OpenFolder_Click" ToolTip="{l:Tr 'Open the recordings folder'}"/>
                                <Button Margin="0,0,0,8" Click="RecordingSettings_Click" ToolTip="{l:Tr 'Folder, sound, HDR and the quality profiles, in Settings → Video → Recording'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{l:Tr 'Settings'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <!-- cameras over the picture, and the same picture as a webcam -->
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="CamerasButton" Margin="0,0,8,8" Click="Cameras_Click"
                                        ToolTip="{l:Tr 'Lay one or more cameras over the recording and the virtual webcam'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="CamerasLabel" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WebcamButton" Margin="0,0,8,8" Click="Webcam_Click"
                                        ToolTip="{l:Tr 'Show this picture, cameras and all, as a webcam Discord or any other program can pick'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AA;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="WebcamLabel" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WebcamMuteButton" Margin="0,0,0,8" Click="WebcamMute_Click"
                                        ToolTip="{l:Tr 'The virtual webcam keeps running but shows a VIDEO MUTED card, so programs don\'t think it\'s gone'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8F8;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="WebcamMuteLabel" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CamerasOffButton" Margin="8,0,0,8" Click="CamerasOff_Click"
                                        ToolTip="{l:Tr 'Take every camera off the picture: the virtual webcam (and a recording) carry on with just the screen'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="CamerasOffLabel" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="4,0,0,8" Padding="8,3" Click="WebcamShortcuts_Click"
                                        ToolTip="{l:Tr 'Shortcuts for the virtual webcam (start / stop, mute, cameras off): key combinations or controller / button box buttons'}">
                                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                </Button>
                            </WrapPanel>
                            <TextBlock x:Name="WebcamStatus" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RecordStatus" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RecordError" Foreground="{DynamicResource ErrorTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <TextBlock x:Name="EncoderText" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- benchmark -->
                    <Border Style="{StaticResource Square}" Grid.Column="2" Grid.Row="2">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Benchmark'}" Style="{StaticResource CardHeader}"/>
                            <WrapPanel>
                                <Button x:Name="BenchButton" Style="{StaticResource AccentButton}" MinWidth="150" Margin="0,0,8,8" Click="Bench_Click"/>
                                <Button Content="{l:Tr 'Benchmarks…'}" Margin="0,0,8,8" Click="Benchmarks_Click" ToolTip="{l:Tr 'Every benchmark: reports, and comparing runs'}"/>
                                <Button Margin="0,0,0,8" Click="BenchSettings_Click" ToolTip="{l:Tr 'The start / stop shortcut, and how long a run lasts'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{l:Tr 'Settings'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock x:Name="BenchStatus" Margin="0,2,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BenchLast" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- history: the whole width, underneath -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'History'}" Style="{StaticResource CardHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{l:Tr 'App'}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="HistoryGameBox" MinWidth="280" SelectionChanged="HistoryGame_Changed"/>
                        </StackPanel>
                        <TextBlock x:Name="HistoryEmpty" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                        <!-- every session's average, the whole width -->
                        <TextBlock x:Name="SessionsGraphTitle" Style="{StaticResource SecondaryText}" Margin="0,4,0,4"/>
                        <g:HistoryGraph x:Name="SessionsGraph" Height="150"/>
                        <!-- under it, the sessions and the one picked -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="230"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- the app's sessions, newest first: click one for its graph -->
                            <ListBox x:Name="SessionsList" MaxHeight="300" SelectionChanged="Session_Changed" ItemContainerStyle="{StaticResource SessionRow}"
                                     Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            <StackPanel Grid.Column="2">
                                <!-- the session's frame rate, then its other figures, centred above its graph -->
                                <TextBlock x:Name="SessionAverage" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SessionDetails" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                <TextBlock x:Name="SessionGraphTitle" HorizontalAlignment="Center" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                <g:HistoryGraph x:Name="SessionGraph" Height="200"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
