<UserControl x:Class="DaisysApp.Applets.Video.Gaming.GamingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core"
             xmlns:hk="clr-namespace:DaisysApp.Shared.Hotkeys;assembly=DaisysApp.Core">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <!-- (the Recording card's: right up against its box, the boxes lined up) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,12,10"/>
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlBorderStrongBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- Two pages, each a sub-tab of Settings → Video (GamingSettingsView hands them out) -->
    <Grid>
        <!-- Overlay: its look, the shortcuts, the games -->
        <StackPanel x:Name="OverlaySettings">
            <!-- the overlay and the shortcuts side by side, the games under them -->
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- overlay -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr 'FPS overlay'}" Style="{StaticResource CardHeader}"/>
                    <CheckBox x:Name="OnlyGamesBox" Content="{l:Tr 'Only show it while a game is in front'}" Margin="0,0,0,8" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                    <CheckBox x:Name="HideCaptureBox" Content="{l:Tr 'Leave it out of recordings and screenshots'}" Margin="0,0,0,12" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Show (Medium and Advanced)'}" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="GraphFpsBox" Content="{l:Tr 'Frame rate'}" Margin="0,0,16,0" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                        <CheckBox x:Name="GraphFrametimeBox" Content="{l:Tr 'Frame time'}" Margin="0,0,16,0" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                        <CheckBox x:Name="GraphVramBox" Content="{l:Tr 'Video memory'}" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Justify'}" Style="{StaticResource Label}"/>
                        <RadioButton x:Name="AlignLeft" GroupName="Align" Content="{l:Tr 'Left'}" Margin="0,0,16,0" Checked="Overlay_Changed"/>
                        <RadioButton x:Name="AlignRight" GroupName="Align" Content="{l:Tr 'Right'}" Checked="Overlay_Changed"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Background colour'}" Style="{StaticResource Label}"/>
                        <StackPanel x:Name="BackgroundSwatches" Orientation="Horizontal"/>
                        <TextBox x:Name="BackgroundBox" Width="80" Margin="6,0,0,0" VerticalContentAlignment="Center" LostFocus="ColorBox_LostFocus"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Background opacity'}" Style="{StaticResource Label}"/>
                        <Slider x:Name="OpacitySlider" Width="220" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="Opacity_Changed"/>
                        <TextBlock x:Name="OpacityText" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="40"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Text colour'}" Style="{StaticResource Label}"/>
                        <StackPanel x:Name="TextSwatches" Orientation="Horizontal"/>
                        <TextBox x:Name="TextColorBox" Width="80" Margin="6,0,0,0" VerticalContentAlignment="Center" LostFocus="ColorBox_LostFocus"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Size'}" Style="{StaticResource Label}"/>
                        <Slider x:Name="ScaleSlider" Width="220" Minimum="50" Maximum="400" SmallChange="10" LargeChange="25" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="Scale_Changed"/>
                        <TextBlock x:Name="ScaleText" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="40"/>
                    </StackPanel>
                    <CheckBox x:Name="LockBox" Content="{l:Tr 'Lock it in place (clicks go through it)'}" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>

                    <CheckBox x:Name="ShowTechBox" Content="{l:Tr 'Advanced: show the game\'s upscaling and frame generation (DLSS, FSR, XeSS, Reflex)'}" Margin="0,16,0,0"
                              Checked="Overlay_Changed" Unchecked="Overlay_Changed"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="26,4,0,0" TextWrapping="Wrap"
                               Text="{l:Tr 'Which of them the game has loaded, and their versions. Loaded isn\'t always switched on: a game can load DLSS and run without it. Which mode it\'s in (Quality, Performance…) only the game knows; NVIDIA\'s indicator below shows it.'}"/>
                    <StackPanel x:Name="NvidiaPanel">
                        <CheckBox x:Name="NvidiaIndicatorBox" Content="{l:Tr 'NVIDIA\'s DLSS indicator in games'}" Margin="0,12,0,0" Click="NvidiaIndicator_Click"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="26,4,0,0" TextWrapping="Wrap"
                                   Text="{l:Tr 'NVIDIA\'s own note in a corner of every DLSS game: the DLSS mode, render resolution and version, and Frame Generation\'s state. It\'s a driver setting, so Windows asks for administrator approval; games pick it up the next time they start.'}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- hotkeys -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Shortcuts'}" Style="{StaticResource CardHeader}"/>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Start / stop recording'}" Style="{StaticResource Label}" MinWidth="220"/>
                        <hk:ShortcutBox x:Name="RecordShortcut" AllowControllerButtons="True" MinWidth="300"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Show / hide the overlay'}" Style="{StaticResource Label}" MinWidth="220"/>
                        <hk:ShortcutBox x:Name="OverlayShortcut" AllowControllerButtons="True" MinWidth="300"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Next overlay mode'}" Style="{StaticResource Label}" MinWidth="220"/>
                        <hk:ShortcutBox x:Name="ModeShortcut" AllowControllerButtons="True" MinWidth="300"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Start / stop the virtual webcam'}" Style="{StaticResource Label}" MinWidth="220"/>
                        <hk:ShortcutBox x:Name="WebcamShortcut" AllowControllerButtons="True" MinWidth="300"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Mute / unmute the virtual webcam'}" Style="{StaticResource Label}" MinWidth="220"/>
                        <hk:ShortcutBox x:Name="WebcamMuteShortcut" AllowControllerButtons="True" MinWidth="300"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Cameras off / on'}" Style="{StaticResource Label}" MinWidth="220"/>
                        <hk:ShortcutBox x:Name="CamerasOffShortcut" AllowControllerButtons="True" MinWidth="300"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Text="{l:Tr 'Click a box, then press a key combination or a controller / button box button. They work anywhere, in games too. The mode shortcut goes Simple → Medium → Advanced and round again.'}"/>
                </StackPanel>
            </Border>
            </Grid>
            <!-- games -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Games'}" Style="{StaticResource CardHeader}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{l:Tr 'A program is added here the first time it shows frames full screen. Give it the name you want to see; untick one that isn\'t a game to ignore it.'}"/>
                    <ItemsControl x:Name="GamesList"/>
                    <TextBlock x:Name="NoGamesText" Style="{StaticResource SecondaryText}" Text="{l:Tr 'None yet: start a game.'}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Recording: where and how, and the performance history -->
        <StackPanel x:Name="RecordingSettings">
            <!-- recording (Video → Recording's Settings button scrolls here) -->
            <Border x:Name="RecordingCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Recording'}" Style="{StaticResource CardHeader}"/>
                    <!-- (since SimEffects Analysis 0.3.3) a label column, right up against the boxes, and the boxes lined up
                         (up to 300 wide, narrower with the card: on SimEffects Analysis' one Settings page) -->
                    <Grid x:Name="RecordingRows" Grid.IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Labels"/>
                            <ColumnDefinition Width="*" MaxWidth="300"/>
                            <ColumnDefinition Width="0.01*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:Tr 'Save to'}" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Grid.Column="1" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{l:Tr 'Change…'}" Margin="8,0,0,0" Click="Folder_Click"/>
                            <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                            <CheckBox x:Name="SystemAudioBox" Content="{l:Tr 'Record the PC\'s sound'}" Margin="0,0,0,8" Checked="Recording_Changed" Unchecked="Recording_Changed"/>
                            <CheckBox x:Name="GameSoundBox" Content="{l:Tr 'Only the game\'s sound'}" Margin="24,0,0,8" Checked="Recording_Changed" Unchecked="Recording_Changed"
                                      ToolTip="{l:Tr 'No voice chat, videos or other programs'}"/>
                            <CheckBox x:Name="MicBox" Margin="0,0,0,8" Checked="Recording_Changed" Unchecked="Recording_Changed">
                                <TextBlock Text="{l:Tr 'Record the microphone too (as a second audio track)'}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="CursorBox" Content="{l:Tr 'Record the mouse pointer'}" Margin="0,0,0,8" Checked="Recording_Changed" Unchecked="Recording_Changed"/>
                            <CheckBox x:Name="OverlaysBox" Content="{l:Tr 'Record overlays'}" Margin="0,0,0,10" Checked="Recording_Changed" Unchecked="Recording_Changed"
                                      ToolTip="{l:Tr 'Off: widgets, overlays and mirrors left out of recordings'}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{l:Tr 'HDR monitors'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="HdrBox" Margin="0,0,0,10" SelectionChanged="Recording_Changed">
                            <ComboBoxItem Content="{l:Tr 'Record in SDR (plays right everywhere)'}"/>
                            <ComboBoxItem Content="{l:Tr 'Record in HDR10 (HEVC or AV1, 10-bit)'}"/>
                        </ComboBox>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" x:Name="EncoderNote" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="{l:Tr 'The picture goes straight from the screen to the graphics card\'s video encoder (NVENC on NVIDIA cards), like the NVIDIA app\'s recorder, so games keep their frame rate. If the encoder can\'t take a setting, recording stops rather than fall back to the processor.'}"/>

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="{l:Tr 'Quality profiles'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Text="{l:Tr 'Profile'}" Style="{StaticResource FieldLabel}" Margin="0,0,12,6"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="ProfileBox" Margin="0,0,0,6" SelectionChanged="ProfileBox_Changed"/>
                        <WrapPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4">
                            <Button Content="{l:Tr 'New'}" Margin="0,0,8,6" Click="NewProfile_Click"/>
                            <Button x:Name="DeleteProfileButton" Content="{l:Tr 'Delete'}" Margin="0,0,0,6" Click="DeleteProfile_Click"/>
                        </WrapPanel>
                        <!-- (since 4.18.12) the profile's settings folded away; changes wait for Save -->
                        <Expander x:Name="ProfileEditor" Grid.Row="7" Grid.ColumnSpan="3" Header="{l:Tr 'Edit'}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4">
                        <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Labels"/>
                            <ColumnDefinition Width="*" MaxWidth="300"/>
                            <ColumnDefinition Width="0.01*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{l:Tr 'Name'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,10" VerticalContentAlignment="Center" LostFocus="Profile_Edited"/>
                        <TextBlock Grid.Row="1" Text="{l:Tr 'Codec'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CodecBox" Margin="0,0,0,10" SelectionChanged="Profile_Edited"/>
                        <TextBlock Grid.Row="2" Text="{l:Tr 'Frame rate'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FpsBox" Margin="0,0,0,10" SelectionChanged="Profile_Edited"/>
                        <TextBlock Grid.Row="3" Text="{l:Tr 'Resolution'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="HeightBox" Margin="0,0,0,10" SelectionChanged="Profile_Edited"/>
                        <TextBlock Grid.Row="4" Text="{l:Tr 'Bit rate'}" Style="{StaticResource FieldLabel}" Margin="0,0,12,6"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="RateControlBox" Margin="0,0,0,6" SelectionChanged="Profile_Edited">
                            <ComboBoxItem Content="{l:Tr 'Variable (VBR)'}"/>
                            <ComboBoxItem Content="{l:Tr 'Constant (CBR)'}"/>
                        </ComboBox>
                        <WrapPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                            <TextBox x:Name="BitrateBox" Width="52" VerticalContentAlignment="Center" LostFocus="Profile_Edited" ToolTip="{l:Tr 'Average'}"/>
                            <TextBlock x:Name="MaxLabel" Text="–" VerticalAlignment="Center" Margin="6,0,6,0"/>
                            <TextBox x:Name="MaxBitrateBox" Width="52" VerticalContentAlignment="Center" LostFocus="Profile_Edited" ToolTip="{l:Tr 'Most'}"/>
                            <TextBlock Text="Mbit/s" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="6" Text="{l:Tr 'Encoder preset'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="QualityBox" Margin="0,0,0,10" SelectionChanged="Profile_Edited">
                            <ComboBoxItem Content="{l:Tr 'Fastest'}" Tag="0"/>
                            <ComboBoxItem Content="{l:Tr 'Balanced'}" Tag="50"/>
                            <ComboBoxItem Content="{l:Tr 'High quality'}" Tag="70"/>
                            <ComboBoxItem Content="{l:Tr 'Best quality'}" Tag="100"/>
                        </ComboBox>
                        <TextBlock Grid.Row="7" Text="{l:Tr 'Keyframe every'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="KeyframeBox" Margin="0,0,0,10" SelectionChanged="Profile_Edited"/>
                        <TextBlock Grid.Row="8" Text="{l:Tr 'Audio'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="8" Grid.Column="1" x:Name="AudioBox" Margin="0,0,0,10" SelectionChanged="Profile_Edited"/>
                        <TextBlock x:Name="ProfileNote" Grid.Row="9" Grid.ColumnSpan="3" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="10" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="SaveProfileButton" Content="{l:Tr 'Save'}" Style="{StaticResource AccentButton}" Margin="0,0,8,0" IsEnabled="False" Click="SaveProfile_Click"/>
                            <Button x:Name="ResetProfilesButton" Content="{l:Tr 'Reset'}" ToolTip="{l:Tr 'High, Medium and Low as they came; your own profiles removed'}"/>
                        </StackPanel>
                        </Grid>
                        </Expander>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- history -->
            <Border x:Name="HistorySettingsCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr 'History'}" Style="{StaticResource CardHeader}"/>
                    <CheckBox x:Name="LogBox" Content="{l:Tr 'Log each game\'s performance (a line a second while it\'s in front)'}" Margin="0,0,0,10" Checked="History_Changed" Unchecked="History_Changed"/>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="{l:Tr 'Keep it for'}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="KeepBox" Width="160" SelectionChanged="History_Changed"/>
                        <Button Content="{l:Tr 'Open the folder'}" Margin="8,0,0,0" Click="OpenHistory_Click"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Text="{l:Tr 'About 350 KB an hour of play, as CSV files (one folder per game, a file a month) that open in Excel.'}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
