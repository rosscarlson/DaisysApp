<Project Sdk="Microsoft.NET.Sdk">
  <!-- See ../Directory.Build.props and ../Template/README.md. One module, three tools on the Video tab: MiniMirror/ and
       Gaming/ (the Overlay and Recording sub-tabs). The Resizer, also on the tab, is a module of its own since 1.1.68
       (src/Modules/Resizer), which joins this tab when both are installed. -->
  <PropertyGroup>
    <!-- Mini Mirror: Screen.AllScreens for the monitor layout -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mini Mirror and Gaming's recording: screen capture (DXGI Desktop Duplication) and colour conversion shaders;
         Gaming's recording also uses the GPU's video encoder through Media Foundation -->
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <!-- the virtual webcam (softcam, built by tools/build-softcam.ps1): camera\x64 and camera\x86 beside the module, which
       the installer registers with Windows -->
  <ItemGroup>
    <None Include="..\..\..\third_party\softcam\x64\softcam.dll" Link="camera\x64\softcam.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\..\third_party\softcam\x86\softcam.dll" Link="camera\x86\softcam.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\..\third_party\softcam\LICENSE" Link="camera\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- WinForms is only used for the screen list; keep its namespaces out of the global usings (WPF name clashes) -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- the shared audio, Voicemeeter or hardware code (copied into the module's folder, with NAudio) -->
    <ProjectReference Include="..\..\DaisysApp.Shared\DaisysApp.Shared.csproj" />
  </ItemGroup>
</Project>
