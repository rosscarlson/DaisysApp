<UserControl x:Class="DaisysApp.Applets.Hardware.UsbMonitor.Devices.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core">

    <UserControl.Resources>
        <!-- the status: bold red when the device is disconnected or has a problem -->
        <Style x:Key="StatusCell" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBad}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="0" Margin="0">
            <DataGrid x:Name="DeviceGrid" BorderThickness="0" HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
                      RowStyle="{StaticResource EventGridRow}" MouseDoubleClick="DeviceGrid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Tr 'Show details'}" Click="Details_Click"/>
                        <MenuItem Header="{l:Tr 'Forget this device'}" Click="Forget_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr 'Status'}" Binding="{Binding Status}" Width="150" MinWidth="100" ElementStyle="{StaticResource StatusCell}"/>
                    <DataGridTextColumn Header="{l:Tr 'Description'}" Binding="{Binding Name}" Width="240" MinWidth="120"/>
                    <DataGridTextColumn Header="{l:Tr 'Manufacturer'}" Binding="{Binding Manufacturer}" Width="130" MinWidth="100"/>
                    <DataGridTextColumn Header="{l:Tr 'VID'}" Binding="{Binding VendorId}" Width="60" MinWidth="50"/>
                    <DataGridTextColumn Header="{l:Tr 'PID'}" Binding="{Binding ProductId}" Width="60" MinWidth="50"/>
                    <DataGridTextColumn Header="{l:Tr 'Last connected'}" Binding="{Binding LastConnected}" Width="140" MinWidth="110"/>
                    <DataGridTextColumn Header="{l:Tr 'Last disconnected'}" Binding="{Binding LastDisconnected}" Width="140" MinWidth="110"/>
                    <DataGridTextColumn Header="{l:Tr 'Last working'}" Binding="{Binding LastWorking}" Width="140" MinWidth="110"/>
                    <DataGridTextColumn Header="{l:Tr 'Device class'}" Binding="{Binding DeviceClass}" Width="100" MinWidth="90"/>
                    <DataGridTextColumn Header="{l:Tr 'Serial number'}" Binding="{Binding SerialNumber}" Width="130" MinWidth="100"/>
                    <DataGridTextColumn Header="{l:Tr 'Location'}" Binding="{Binding Location}" Width="150" MinWidth="90"/>
                    <DataGridTextColumn Header="{l:Tr 'First seen'}" Binding="{Binding FirstSeen}" Width="140" MinWidth="110"/>
                    <DataGridTextColumn Header="{l:Tr 'Known from'}" Binding="{Binding Source}" Width="110" MinWidth="90"/>
                    <DataGridTextColumn Header="{l:Tr 'Device instance ID'}" Binding="{Binding InstanceId}" Width="*" MinWidth="260"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <Button x:Name="ResetFiltersButton" DockPanel.Dock="Right" Content="{l:Tr 'Reset filters'}" Margin="12,0,0,0"
                    Visibility="Collapsed" Click="ResetFilters_Click"
                    ToolTip="{l:Tr 'Show every row again (right-click a column header to filter or sort)'}"/>
            <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{l:Tr 'Every USB device seen here, and the ones Windows remembers. Double-click one for its details; right-click a column header to filter or sort, or a device to forget it.'}"/>
        </DockPanel>
    </Grid>
</UserControl>
