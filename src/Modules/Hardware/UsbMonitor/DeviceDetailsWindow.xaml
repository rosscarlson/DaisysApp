<Window x:Class="DaisysApp.Applets.Hardware.UsbMonitor.DeviceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core"
        Title="{l:Tr 'Device details'}" Width="780" MinWidth="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Selectable, read-only value text that looks like a plain label -->
        <Style x:Key="ValueText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SubText" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <!-- a problem: what it means, and which known device it most likely is -->
            <Border x:Name="AnalysisBox" Margin="0,10,0,0" Padding="12,8" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource ErrorTextBrush}" Visibility="Collapsed">
                <TextBlock x:Name="AnalysisText" TextWrapping="Wrap" Foreground="{DynamicResource ErrorTextBrush}" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,6" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Probable Device: what it probably is in a word or two; click for the plain-English explanation -->
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                        <StackPanel>
                            <Grid x:Name="ProbableRow" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ProbableRow_Click"
                                  ToolTip="{l:Tr 'Show or hide what it probably is, where it is plugged in and how to find it'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Tr 'Probable Device:'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,12,0"/>
                                <TextBlock x:Name="ProbableText" Grid.Column="1" Text="{l:Tr 'Working it out…'}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ProbableChevron" Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Margin="10,3,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                            <StackPanel x:Name="IdentifyPanel" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="PropertyList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,12,0"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Value, Mode=OneWay}"/>
                                        <Button Grid.Column="2" Padding="7,3" MinHeight="26" Margin="10,-3,0,-3" VerticalAlignment="Top"
                                                ToolTip="{l:Tr 'Copy this value'}" Click="CopyValue_Click">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{l:Tr 'Copy all to clipboard'}" Click="CopyAll_Click"/>
            <TextBlock x:Name="CopiedText" DockPanel.Dock="Left" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Close'}" Click="Close_Click" MinWidth="80" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
