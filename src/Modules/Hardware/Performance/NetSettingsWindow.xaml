<Window x:Class="DaisysApp.Applets.Hardware.Performance.NetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core"
        Title="{l:Tr 'Network Tests'}" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{l:Tr 'Network Tests'}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,14" TextWrapping="Wrap"
                   Text="{l:Tr 'Each host is pinged once a second while Daisy\'s App runs, and its response time graphed. Your router shows how your own network is doing; a server out on the internet shows your connection to it.'}"/>

        <Border Style="{StaticResource Card}" Margin="0">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr 'Name'}" Style="{StaticResource SecondaryText}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{l:Tr 'IP address or hostname'}" Style="{StaticResource SecondaryText}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{l:Tr 'Max (ms)'}" Style="{StaticResource SecondaryText}" FontWeight="SemiBold" Margin="8,0,0,0"
                               ToolTip="{l:Tr 'A response slower than this turns the host\'s line bold and red in the graph'}"/>
                    <TextBlock Grid.Column="3" Text="{l:Tr 'Red for (s)'}" Style="{StaticResource SecondaryText}" FontWeight="SemiBold" Margin="8,0,0,0"
                               ToolTip="{l:Tr 'How long the line stays bold and red after the last response over Max'}"/>
                </Grid>
                <ItemsControl x:Name="HostList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr 'What to call it (optional)'}"/>
                                <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{l:Tr 'e.g. 192.168.1.1, 1.1.1.1 or www.example.com'}"/>
                                <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding AlertText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right"
                                         ToolTip="{l:Tr 'A response slower than this turns the host\'s line bold and red in the graph'}"/>
                                <TextBox Grid.Column="3" Margin="8,0,0,0" Text="{Binding HoldText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right"
                                         ToolTip="{l:Tr 'How long the line stays bold and red after the last response over Max'}"/>
                                <Button Grid.Column="4" Margin="6,0,0,0" Padding="6,3" Click="Remove_Click" ToolTip="{l:Tr 'Remove this host'}"
                                        AutomationProperties.Name="Remove">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Click="Add_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{l:Tr 'Add host'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RouterButton" Click="Router_Click" Content="{l:Tr 'Add my router'}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{l:Tr 'Graph'}" Style="{StaticResource CardHeader}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Tr 'Top of the graph'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="GraphMaxBox" Width="70" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{l:Tr 'The graph goes from 0 to this; a slower response runs along the top. 0 fits the graph to the responses instead.'}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Cancel'}" MinWidth="90" IsCancel="True" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Save'}" MinWidth="90" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click"/>
            <Border/>
        </DockPanel>
    </StackPanel>
</Window>
