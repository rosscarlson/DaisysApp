<UserControl x:Class="DaisysApp.Applets.Hardware.Performance.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core"
             xmlns:local="clr-namespace:DaisysApp.Applets.Hardware.Performance"
             xmlns:ch="clr-namespace:DaisysApp.Shared.Charts;assembly=DaisysApp.Core"
             xmlns:sh="clr-namespace:DaisysApp.Shared;assembly=DaisysApp.Core">

    <UserControl.Resources>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- ten columns beside the side cards: tighter padding than the shared table style -->
        <Style x:Key="TightCell" TargetType="DataGridCell" BasedOn="{StaticResource EventGridCell}">
            <Setter Property="Padding" Value="6,6"/>
        </Style>
        <Style x:Key="CenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource EventGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,8"/>
        </Style>
        <Style x:Key="RightHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource EventGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,8,6,8"/>
        </Style>
        <!-- processes over an orange / red level (Performance → gear) -->
        <Style x:Key="ProcessRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource EventGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="1">
                    <Setter Property="Background" Value="#38F7A541"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="2">
                    <Setter Property="Background" Value="#48F0524C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="Margin" Value="0,0,12,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
            <!-- at a glance: built in code, one tile per metric group; click a tile for its history -->
            <UniformGrid x:Name="Tiles" Columns="4" Margin="-6,0,-6,0"/>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Top">
                <Border x:Name="ProcessCard" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="200" TextChanged="SearchBox_TextChanged"
                                     ToolTip="{l:Tr 'Show only processes whose name contains this'}"/>
                            <TextBlock DockPanel.Dock="Right" Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button DockPanel.Dock="Right" Click="ProcessSettings_Click" Padding="8,4" Margin="0,0,12,0"
                                    ToolTip="{l:Tr 'Process warnings (when a row turns orange or red) and how often the list refreshes'}">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{l:Tr 'Processes'}" Style="{StaticResource CardHeader}" Margin="0"/>
                                <TextBlock x:Name="ProcessCount" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- the Network column's permission (PerformanceView.Processes.cs: ShowNetStatus) -->
                        <Border x:Name="NetPermissionPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="{DynamicResource ControlBrush}"
                                CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button x:Name="NetAllowButton" Style="{StaticResource AccentButton}" Content="{l:Tr 'Allow…'}" Click="NetAllow_Click" Margin="0,0,8,0"/>
                                    <Button Content="{l:Tr 'Try again'}" Click="NetRetry_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="NetPermissionText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <sh:LiveDataGrid x:Name="ProcessGrid" Height="430" BorderThickness="0" IsReadOnly="True" HorizontalScrollBarVisibility="Auto"
                                  RowStyle="{StaticResource ProcessRowStyle}" CellStyle="{StaticResource TightCell}" MouseDoubleClick="ProcessGrid_MouseDoubleClick"
                                  EnableRowVirtualization="True" Sorting="ProcessGrid_Sorting"
                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                            <sh:LiveDataGrid.GroupStyle>
                                <GroupStyle>
                                    <!-- each group's rows indented under its heading -->
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <ContentPresenter/>
                                                            <ItemsPresenter Margin="10,0,0,0"/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="10,12,0,6" FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </sh:LiveDataGrid.GroupStyle>
                            <sh:LiveDataGrid.Columns>
                                <!-- a name's processes are one row, with an arrow to open it (PerformanceView.Processes.cs) -->
                                <DataGridTemplateColumn Header="{l:Tr 'Name'}" Width="*" MinWidth="120" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                                <TextBlock Text="{Binding Arrow}" Width="18" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Background="Transparent" Cursor="Hand"
                                                           MouseLeftButtonDown="ProcessArrow_MouseDown" ToolTip="{Binding ArrowTip}"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="{Binding NameWeight}" ToolTip="{Binding NameTip}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:Tr 'PID'}" Binding="{Binding Pid}" Width="58" MinWidth="54" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="{l:Tr 'CPU'}" Binding="{Binding Cpu, StringFormat={}{0:0.0} %}" Width="62" MinWidth="58" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="{l:Tr 'RAM'}" Binding="{Binding MemoryMB, StringFormat={}{0:#,0} MB}" Width="76" MinWidth="72" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="{l:Tr 'GPU'}" Binding="{Binding Gpu, StringFormat={}{0:0.0} %}" Width="60" MinWidth="56" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="{l:Tr 'GPU engine'}" Binding="{Binding GpuEngine}" Width="96" MinWidth="86" HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding GpuName}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{l:Tr 'VRAM'}" Binding="{Binding VramMB, StringFormat={}{0:#,0} MB}" Width="76" MinWidth="70" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="{l:Tr 'Disk'}" Binding="{Binding IoMBps, StringFormat={}{0:0.0} MB/s}" Width="78" MinWidth="74" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="{l:Tr 'Network'}" Binding="{Binding NetText, Mode=OneWay}" SortMemberPath="Net" Width="74" MinWidth="70" HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Number}">
                                            <Setter Property="ToolTip" Value="{Binding NetTip}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{l:Tr 'Threads'}" Binding="{Binding Threads}" Width="70" MinWidth="66" ElementStyle="{StaticResource Number}" HeaderStyle="{StaticResource RightHeader}"/>
                            </sh:LiveDataGrid.Columns>
                        </sh:LiveDataGrid>
                    </DockPanel>
                </Border>

                <!-- widgets: the graphs popped out of a history window onto the desktop -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Widgets'}" Style="{StaticResource CardHeader}"/>
                        <StackPanel x:Name="WidgetList"/>
                    </StackPanel>
                </Border>
                </StackPanel>

                <StackPanel x:Name="SidePanel" Grid.Column="2" VerticalAlignment="Top">
                    <!-- Network Tests: each host's response time, once a second -->
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Click="NetSettings_Click" Padding="8,4"
                                        ToolTip="{l:Tr 'Hosts to test'}" AutomationProperties.Name="Network test settings">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                                <CheckBox x:Name="NetOnBox" VerticalAlignment="Center" Checked="NetOn_Click" Unchecked="NetOn_Click"
                                          ToolTip="{l:Tr 'Untick to stop the pings completely'}" AutomationProperties.Name="Network Tests on">
                                    <TextBlock Text="{l:Tr 'Network Tests'}" Style="{StaticResource CardHeader}" Margin="0"/>
                                </CheckBox>
                            </DockPanel>
                            <TextBlock x:Name="NetOffText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"
                                       Text="{l:Tr 'Off: no pings are sent. Tick the box to start again.'}"/>
                            <StackPanel x:Name="NetBody">
                            <ItemsControl x:Name="PingList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8" ToolTip="{Binding Tip}" Background="Transparent" Cursor="Hand"
                                                   Opacity="{Binding Opacity}" MouseLeftButtonUp="PingRow_Click">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Rectangle DockPanel.Dock="Left" Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding Swatch}"
                                                       VerticalAlignment="Top" Margin="0,4,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoHosts" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="{l:Tr 'No hosts to test. Add some with the gear.'}"/>
                            <!-- detailed: a value scale, times, and the values under the mouse -->
                            <ch:LineGraph x:Name="PingGraph" Height="120" Margin="0,4,0,0" Detailed="True" TimeSpans="2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Speed Test: on a schedule, results graphed; orange / red when slow or failed -->
                    <Border x:Name="SpeedCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button x:Name="SpeedRunButton" DockPanel.Dock="Right" Click="SpeedRun_Click" Padding="10,4" Content="{l:Tr 'Run now'}"
                                        ToolTip="{l:Tr 'Run a speed test now'}"/>
                                <Button DockPanel.Dock="Right" Click="SpeedSettings_Click" Padding="8,4" Margin="0,0,8,0"
                                        ToolTip="{l:Tr 'Schedule, test length and warning levels'}" AutomationProperties.Name="Speed test settings">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                                <CheckBox x:Name="SpeedOnBox" VerticalAlignment="Center" Checked="SpeedOn_Click" Unchecked="SpeedOn_Click"
                                          ToolTip="{l:Tr 'Untick to stop speed tests completely (scheduled and Run now)'}" AutomationProperties.Name="Speed Test on">
                                    <TextBlock Text="{l:Tr 'Speed Test'}" Style="{StaticResource CardHeader}" Margin="0"/>
                                </CheckBox>
                            </DockPanel>
                            <TextBlock x:Name="SpeedOffText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"
                                       Text="{l:Tr 'Off: no speed tests run, scheduled or otherwise. Tick the box to start again.'}"/>
                            <StackPanel x:Name="SpeedBody">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{l:Tr 'Download'}" Style="{StaticResource SecondaryText}"/>
                                    </StackPanel>
                                    <TextBlock>
                                        <Run x:Name="DownText" Text="—" FontSize="20" FontWeight="SemiBold"/><Run x:Name="DownUnit" Text=" Mbit/s" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#F7A541" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{l:Tr 'Upload'}" Style="{StaticResource SecondaryText}"/>
                                    </StackPanel>
                                    <TextBlock>
                                        <Run x:Name="UpText" Text="—" FontSize="20" FontWeight="SemiBold"/><Run x:Name="UpUnit" Text=" Mbit/s" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:Tr 'Latency'}" Style="{StaticResource SecondaryText}"/>
                                    <TextBlock>
                                        <Run x:Name="LatencyText" Text="—" FontSize="20" FontWeight="SemiBold"/><Run Text=" ms" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <!-- while testing, or after a failure: one line; otherwise the details, aligned like the System card -->
                            <TextBlock x:Name="SpeedStatus" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Grid x:Name="SpeedDetails" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{l:Tr 'Last test'}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,12,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SpeedLastText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <!-- the server and the data used are in the gear's Information group -->
                                <TextBlock Grid.Row="1" Text="{l:Tr 'Next test'}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,12,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SpeedNextText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <ch:LineGraph x:Name="SpeedGraph" Height="120" Margin="0,10,0,0" Detailed="True" TimeSpans="2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Storage'}" Style="{StaticResource CardHeader}"/>
                            <ItemsControl x:Name="DriveList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Free}" Style="{StaticResource SecondaryText}" FontSize="12.5"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <Border Height="8" CornerRadius="4" Margin="0,6,0,0" Background="{DynamicResource ControlBorderBrush}" ClipToBounds="True">
                                                <Border CornerRadius="4" Background="{Binding BarBrush}" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Used}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'System'}" Style="{StaticResource CardHeader}"/>
                            <Grid x:Name="InfoGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
