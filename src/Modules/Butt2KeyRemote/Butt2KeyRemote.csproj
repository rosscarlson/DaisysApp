<Project Sdk="Microsoft.NET.Sdk">
  <!-- See ../Directory.Build.props and ../Template/README.md. Button2Key Remote: ButtScreens of buttons for a phone,
       tablet or PC (or popped out on this one) that do what Button2Key's inputs do. -->
  <ItemGroup>
    <!-- Button2Key's actions, keys and the window that sets them up -->
    <ProjectReference Include="..\..\DaisysApp.Controllers\DaisysApp.Controllers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the icon library: Material Design Icons (Pictogrammers, Apache 2.0), one 24x24 path each -->
    <EmbeddedResource Include="Icons\mdi.txt.gz" LogicalName="mdi.txt.gz" />
    <!-- the built-in templates (the template wizard; yours go in %APPDATA%\DaisysApp\Butt2KeyRemote\Templates) -->
    <EmbeddedResource Include="Templates\*.json" LogicalName="templates/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- the passphrase, encrypted for the Windows user -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
