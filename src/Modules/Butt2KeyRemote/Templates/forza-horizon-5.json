{
  "name": "Forza Horizon 5",
  "description": "Gears, clutch and handbrake, rewind, cameras and looking round, the map, telemetry, the radio and ANNA. The game's own keyboard keys (Settings → Controls → Change Input Mapping): change a button's keys if you've changed the game's.",
  "programs": [ "ForzaHorizon5.exe" ],
  "columns": 4,
  "rows": 6,
  "theme": "Badonkadonk",
  "groups": [
    {
      "name": "Driving",
      "buttons": [
        { "label": "Shift Up", "icon": "arrow-up-bold", "keys": [ "E" ] },
        { "label": "Shift Down", "icon": "arrow-down-bold", "keys": [ "Q" ] },
        { "label": "Clutch", "icon": "car-shift-pattern", "keys": [ "LShift" ], "mode": "Hold" },
        { "label": "Handbrake", "icon": "car-brake-parking", "keys": [ "Space" ], "mode": "Hold" },
        { "label": "Rewind", "icon": "rewind", "keys": [ "R" ], "wide": 2 },
        { "label": "Horn", "icon": "bullhorn", "keys": [ "H" ], "mode": "Hold", "wide": 2 }
      ]
    },
    {
      "name": "Camera and looking",
      "buttons": [
        { "label": "Change Camera", "icon": "camera-switch", "keys": [ "Tab" ] },
        { "label": "Look Back", "icon": "car-back", "keys": [ "Down" ], "mode": "Hold" },
        { "label": "Look Left", "icon": "eye-arrow-left", "keys": [ "Left" ], "mode": "Hold" },
        { "label": "Look Right", "icon": "eye-arrow-right", "keys": [ "Right" ], "mode": "Hold" },
        { "label": "Photo Mode", "icon": "camera", "keys": [ "P" ], "selected": false }
      ]
    },
    {
      "name": "Map and info",
      "buttons": [
        { "label": "Map", "icon": "map", "keys": [ "M" ] },
        { "label": "Telemetry", "icon": "chart-line", "keys": [ "T" ] },
        { "label": "Next Telemetry", "icon": "page-next", "keys": [ "PageUp" ] },
        { "label": "Previous Telemetry", "icon": "page-previous", "keys": [ "PageDown" ] },
        { "label": "Mini Leaderboard", "icon": "format-list-numbered", "keys": [ "L" ], "selected": false }
      ]
    },
    {
      "name": "Radio and car",
      "buttons": [
        { "label": "Previous Station", "icon": "skip-previous", "keys": [ "Minus" ] },
        { "label": "Next Station", "icon": "skip-next", "keys": [ "Equals" ] },
        { "label": "Convertible Top", "icon": "car-convertible", "keys": [ "G" ] },
        { "label": "Activate", "icon": "checkbox-marked-circle", "keys": [ "Enter" ] },
        { "label": "Pause", "icon": "pause", "keys": [ "Esc" ], "selected": false }
      ]
    },
    {
      "name": "ANNA and Forza LINK",
      "selected": false,
      "buttons": [
        { "label": "ANNA", "icon": "robot", "keys": [ "C" ] },
        { "label": "Forza LINK", "icon": "link-variant", "keys": [ "V" ] },
        { "label": "Option 1", "icon": "numeric-1-box", "keys": [ "D1" ] },
        { "label": "Option 2", "icon": "numeric-2-box", "keys": [ "D2" ] },
        { "label": "Option 3", "icon": "numeric-3-box", "keys": [ "D3" ] },
        { "label": "Option 4", "icon": "numeric-4-box", "keys": [ "D4" ] }
      ]
    }
  ]
}
