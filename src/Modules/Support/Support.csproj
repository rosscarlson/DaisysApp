<Project Sdk="Microsoft.NET.Sdk">
  <!-- See ../Directory.Build.props and ../Template/README.md. One module, two tools: Networking/ (Network Tools,
       with its own tools on sub-tabs of their own) and StressTests/ (Stress Tests). The time graph and the speed test
       are DaisysApp.Core's (Shared/Charts, Shared/Network); Network Tools uses .NET and Windows' own APIs (WLAN, IP
       Helper). -->
  <ItemGroup>
    <Using Include="DaisysApp.Shared.Charts" />
    <Using Include="DaisysApp.Shared.Network" />
  </ItemGroup>
  <ItemGroup>
    <!-- Stress Tests: the GPU's 3D, compute and memory tests (Direct3D 11), and its video encoder and decoder (Media
         Foundation) -->
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tools (QuickTools/, from the Tools module in 3.24.9): the Tools module's cards and sizes, the same files -->
    <Compile Include="..\Tools\Shared\Ui.cs" Link="QuickTools\Shared\Ui.cs" />
    <Compile Include="..\Tools\Shared\Sizes.cs" Link="QuickTools\Shared\Sizes.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Stress Tests: the hardware readings while a test runs (NVIDIA's GPU library, Windows' counters,
         LibreHardwareMonitor); copied into the module's folder -->
    <ProjectReference Include="..\..\DaisysApp.Shared\DaisysApp.Shared.csproj" />
  </ItemGroup>
</Project>
