// Assetto Corsa Competizione. Binder keeps the bindings (format "sheet"): ACC keeps its own in Config\controls.json (one entry per wheel rim: not
// written yet). Defaults: Alt+L the pit limiter and Alt+R the wipers (a user-made list: check them). Defaults are left out where they couldn't be checked; set them in the game, or add "keys" here.
{
  "id": "assetto-corsa-competizione",
  "name": "Assetto Corsa Competizione",
  "kind": "racing",
  "format": "sheet",
  "folderHint": "ACC's Config folder (Documents\\Assetto Corsa Competizione\\Config)",
  "find": ["documents:Assetto Corsa Competizione\\Config"],
  "programs": ["AC2-Win64-Shipping"],
  "options": {
    "file": "controls.json"
  },
  "actions": [
    { "id": "steering", "label": "Steering", "group": "Driving", "role": "steer", "axis": true },
    { "id": "throttle", "label": "Throttle", "group": "Driving", "role": "gas", "axis": true, "centred": false },
    { "id": "brake", "label": "Brake", "group": "Driving", "role": "brake", "axis": true, "centred": false },
    { "id": "clutch", "label": "Clutch", "group": "Driving", "role": "clutch", "axis": true, "centred": false },
    { "id": "handbrake", "label": "Handbrake", "group": "Driving", "role": "handbrake", "axis": true, "centred": false },
    { "id": "steer_left", "label": "Steer Left", "group": "Keyboard Driving", "role": "steer.left" },
    { "id": "steer_right", "label": "Steer Right", "group": "Keyboard Driving", "role": "steer.right" },
    { "id": "throttle_key", "label": "Throttle (key)", "group": "Keyboard Driving", "role": "gas.key" },
    { "id": "brake_key", "label": "Brake (key)", "group": "Keyboard Driving", "role": "brake.key" },
    { "id": "shift_up", "label": "Shift Up", "group": "Gears", "role": "gear.up" },
    { "id": "shift_down", "label": "Shift Down", "group": "Gears", "role": "gear.down" },
    { "id": "reverse", "label": "Reverse", "group": "Gears", "role": "gear.r" },
    { "id": "neutral", "label": "Neutral", "group": "Gears", "role": "gear.n" },
    { "id": "gear_1", "label": "Gear 1", "group": "Gears", "role": "gear.1" },
    { "id": "gear_2", "label": "Gear 2", "group": "Gears", "role": "gear.2" },
