    { "id": "starter", "label": "Starter", "group": "Car", "role": "starter" },
    { "id": "pit_limiter", "label": "Pit Limiter", "group": "Car", "role": "pitlimiter", "keys": [ "Alt+L" ] },
    { "id": "headlights", "label": "Headlights", "group": "Car", "role": "lights" },
    { "id": "flash_headlights", "label": "Flash Headlights", "group": "Car", "role": "lights.flash" },
    { "id": "rain_light", "label": "Rain Light", "group": "Car", "role": "lights.rain" },
    { "id": "wipers", "label": "Wipers", "group": "Car", "role": "wipers", "keys": [ "Alt+R" ] },
