// Fate of the Galaxy (FreeSpace Open, installed by Knossos.NET). The actions, groups and defaults come from the game's
// engine and the mod's tables; these give the ones that matter their role (how bindings are copied between titles, and
// what the example device shows).
{
  "id": "fate-of-the-galaxy",
  "name": "Fate of the Galaxy",
  "kind": "space",
  "format": "fso",
  "folderHint": "The folder with Knossos.NET.exe",
  "find": [
    "G:\\Games\\Fate of the Galaxy",
    "C:\\Games\\Fate of the Galaxy",
    "D:\\Games\\Fate of the Galaxy",
    "%ProgramFiles%\\Fate of the Galaxy",
    "%USERPROFILE%\\Games\\Fate of the Galaxy"
  ],
  "programs": ["fs2_open_26_0_1_x64_AVX", "fs2_open_26_0_1_x64_AVX-FASTDBG", "fs2_open_26_0_1_x64", "fs2_open_26_0_1"],
