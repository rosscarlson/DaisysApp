// iRacing. Binder keeps the bindings (format "sheet"): iRacing keeps its own in controls.cfg (a binary file) in Documents\iRacing.
// Defaults: the black box and replay keys from iRacing's keyboard template (iracing.com/keyboard-shortcuts). Defaults are left out where they couldn't be checked; set them in the game, or add "keys" here.
{
  "id": "iracing",
  "name": "iRacing",
  "kind": "racing",
  "format": "sheet",
  "folderHint": "iRacing's folder in Documents (with controls.cfg)",
  "find": ["documents:iRacing", "D:\\iRacing", "%ProgramFiles(x86)%\\iRacing", "C:\\iRacing"],
  "programs": ["iRacingSim64DX11", "iRacingSim64DX12"],
  "options": {
    "file": "controls.cfg"
  },
  "actions": [
    { "id": "steering", "label": "Steering", "group": "Driving", "role": "steer", "axis": true },
    { "id": "throttle", "label": "Throttle", "group": "Driving", "role": "gas", "axis": true, "centred": false },
    { "id": "brake", "label": "Brake", "group": "Driving", "role": "brake", "axis": true, "centred": false },
    { "id": "clutch", "label": "Clutch", "group": "Driving", "role": "clutch", "axis": true, "centred": false },
    { "id": "handbrake", "label": "Handbrake", "group": "Driving", "role": "handbrake", "axis": true, "centred": false },
    { "id": "steer_left", "label": "Steer Left", "group": "Keyboard Driving", "role": "steer.left" },
    { "id": "steer_right", "label": "Steer Right", "group": "Keyboard Driving", "role": "steer.right" },
    { "id": "throttle_key", "label": "Throttle (key)", "group": "Keyboard Driving", "role": "gas.key" },
    { "id": "brake_key", "label": "Brake (key)", "group": "Keyboard Driving", "role": "brake.key" },
    { "id": "shift_up", "label": "Shift Up", "group": "Gears", "role": "gear.up" },
    { "id": "shift_down", "label": "Shift Down", "group": "Gears", "role": "gear.down" },
    { "id": "reverse", "label": "Reverse", "group": "Gears", "role": "gear.r" },
    { "id": "neutral", "label": "Neutral", "group": "Gears", "role": "gear.n" },
    { "id": "gear_1", "label": "Gear 1", "group": "Gears", "role": "gear.1" },
    { "id": "gear_2", "label": "Gear 2", "group": "Gears", "role": "gear.2" },
    { "id": "gear_3", "label": "Gear 3", "group": "Gears", "role": "gear.3" },
    { "id": "gear_4", "label": "Gear 4", "group": "Gears", "role": "gear.4" },
    { "id": "gear_5", "label": "Gear 5", "group": "Gears", "role": "gear.5" },
    { "id": "gear_6", "label": "Gear 6", "group": "Gears", "role": "gear.6" },
    { "id": "gear_7", "label": "Gear 7", "group": "Gears", "role": "gear.7" },
    { "id": "starter", "label": "Starter", "group": "Car", "role": "starter" },
    { "id": "ignition", "label": "Ignition", "group": "Car", "role": "ignition" },
    { "id": "pit_speed_limiter", "label": "Pit Speed Limiter", "group": "Car", "role": "pitlimiter" },
    { "id": "headlight_flash", "label": "Headlight Flash", "group": "Car", "role": "lights.flash" },
    { "id": "headlights", "label": "Headlights", "group": "Car", "role": "lights" },
    { "id": "wipers", "label": "Wipers", "group": "Car", "role": "wipers" },
    { "id": "brake_bias_up", "label": "Brake Bias +", "group": "Car", "role": "bias.up" },
    { "id": "brake_bias_down", "label": "Brake Bias -", "group": "Car", "role": "bias.down" },
    { "id": "traction_control_up", "label": "Traction Control +", "group": "Car", "role": "tc.up" },
    { "id": "traction_control_down", "label": "Traction Control -", "group": "Car", "role": "tc.down" },
    { "id": "abs_up", "label": "ABS +", "group": "Car", "role": "abs.up" },
    { "id": "abs_down", "label": "ABS -", "group": "Car", "role": "abs.down" },
    { "id": "push_to_pass", "label": "Push to Pass", "group": "Car", "role": "kers" },
    { "id": "drs", "label": "DRS", "group": "Car", "role": "drs" },
    { "id": "look_left", "label": "Look Left", "group": "Views", "role": "look.left" },
    { "id": "look_right", "label": "Look Right", "group": "Views", "role": "look.right" },
    { "id": "look_back", "label": "Look Back", "group": "Views", "role": "look.back" },
    { "id": "recenter_vr", "label": "Recenter VR", "group": "Views", "role": "vr.recentre" },
    { "id": "splits_delta", "label": "Splits / Delta", "group": "Black Box", "keys": [ "Tab" ] },
    { "id": "lap_timing", "label": "Lap Timing", "group": "Black Box", "keys": [ "F1" ] },
    { "id": "standings", "label": "Standings", "group": "Black Box", "keys": [ "F2" ] },
    { "id": "relative", "label": "Relative", "group": "Black Box", "keys": [ "F3" ] },
    { "id": "fuel", "label": "Fuel", "group": "Black Box", "keys": [ "F4" ] },
    { "id": "tire_pressure", "label": "Tire Pressure", "group": "Black Box", "keys": [ "F5" ] },
    { "id": "tire_info", "label": "Tire Info", "group": "Black Box", "keys": [ "F6" ] },
    { "id": "pit_adjustments", "label": "Pit Adjustments", "group": "Black Box", "role": "pit.menu", "keys": [ "F7" ] },
    { "id": "in_car_adjustments", "label": "In-Car Adjustments", "group": "Black Box", "keys": [ "F8" ] },
    { "id": "mirror_adjust", "label": "Mirror Adjust", "group": "Black Box", "keys": [ "F9" ] },
    { "id": "radio", "label": "Radio", "group": "Black Box", "keys": [ "F10" ] },
    { "id": "push_to_talk", "label": "Push to Talk", "group": "Black Box" },
    { "id": "toggle_ui_replay", "label": "Toggle UI (replay)", "group": "Replay", "role": "hud", "keys": [ "Space" ] },
    { "id": "play_pause", "label": "Play / Pause", "group": "Replay", "keys": [ "Numpad 5" ] },
    { "id": "stop", "label": "Stop", "group": "Replay", "keys": [ "Numpad ." ] },
    { "id": "fast_forward", "label": "Fast Forward", "group": "Replay", "keys": [ "Shift+Numpad 6" ] },
    { "id": "rewind", "label": "Rewind", "group": "Replay", "keys": [ "Shift+Numpad 4" ] },
    { "id": "slow_motion", "label": "Slow Motion", "group": "Replay", "keys": [ "Numpad 8" ] },
    { "id": "next_frame", "label": "Next Frame", "group": "Replay", "keys": [ "Numpad 6" ] },
    { "id": "previous_frame", "label": "Previous Frame", "group": "Replay", "keys": [ "Numpad 4" ] }
  ]
}
