// Forza Horizon 4. Binder keeps the bindings (format "sheet"): the game keeps its own with its save (Xbox's cloud).
// Defaults: keyboard driving W, S, A, D; E and Q to shift; Space the handbrake, Left Shift the clutch, R rewind, C the camera. Defaults are left out where they couldn't be checked; set them in the game, or add "keys" here.
{
  "id": "forza-horizon-4",
  "name": "Forza Horizon 4",
  "kind": "racing",
  "format": "sheet",
  "folderHint": "Forza Horizon 4's folder",
  "find": ["steam:ForzaHorizon4", "C:\\XboxGames\\Forza Horizon 4", "D:\\XboxGames\\Forza Horizon 4", "G:\\XboxGames\\Forza Horizon 4"],
  "programs": ["ForzaHorizon4"],
  "actions": [
    { "id": "steering", "label": "Steering", "group": "Driving", "role": "steer", "axis": true },
    { "id": "throttle", "label": "Throttle", "group": "Driving", "role": "gas", "axis": true, "centred": false },
    { "id": "brake", "label": "Brake", "group": "Driving", "role": "brake", "axis": true, "centred": false },
    { "id": "clutch", "label": "Clutch", "group": "Driving", "role": "clutch", "axis": true, "centred": false },
    { "id": "handbrake", "label": "Handbrake", "group": "Driving", "role": "handbrake", "axis": true, "centred": false },
    { "id": "steer_left", "label": "Steer Left", "group": "Keyboard Driving", "role": "steer.left", "keys": [ "A" ] },
    { "id": "steer_right", "label": "Steer Right", "group": "Keyboard Driving", "role": "steer.right", "keys": [ "D" ] },
    { "id": "throttle_key", "label": "Throttle (key)", "group": "Keyboard Driving", "role": "gas.key", "keys": [ "W" ] },
    { "id": "brake_key", "label": "Brake (key)", "group": "Keyboard Driving", "role": "brake.key", "keys": [ "S" ] },
    { "id": "shift_up", "label": "Shift Up", "group": "Gears", "role": "gear.up", "keys": [ "E" ] },
    { "id": "shift_down", "label": "Shift Down", "group": "Gears", "role": "gear.down", "keys": [ "Q" ] },
    { "id": "reverse", "label": "Reverse", "group": "Gears", "role": "gear.r" },
    { "id": "neutral", "label": "Neutral", "group": "Gears", "role": "gear.n" },
