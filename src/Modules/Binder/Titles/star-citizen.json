// Star Citizen. Binder keeps the bindings (format "sheet"): Star Citizen keeps its own in user\client\0\Profiles\default\actionmaps.xml
// (only what differs from its defaults). Defaults: the long-standing ones (W, A, S, D, Space and Left Ctrl to strafe, Q
// and E to roll, the mouse to aim, Left Shift boost, X the space brake, N the gear, R flight ready, F1 mobiGlas, F2 the
// star map); patches move some. Defaults are left out where they couldn't be checked; set them in the game, or add "keys" here.
// Import (3.36.8): actionmaps.xml under the folder picked (its LIVE folder or D:\RSI: looked for a few folders down);
// "game": Star Citizen's action names as known (not checked on the rig: it has no actionmaps.xml yet); its others come
// in under From the game.
{
  "id": "star-citizen",
  "name": "Star Citizen",
  "kind": "space",
  "format": "sheet",
  "folderHint": "Star Citizen's LIVE folder",
  "find": ["D:\\RSI\\StarCitizen\\LIVE", "%ProgramFiles%\\Roberts Space Industries\\StarCitizen\\LIVE", "C:\\RSI\\StarCitizen\\LIVE", "G:\\RSI\\StarCitizen\\LIVE"],
  "programs": ["StarCitizen"],
  "options": {
    "import": "sc",
    "importFile": "user\\client\\0\\Profiles\\default\\actionmaps.xml",
    "file": "user\\client\\0\\Profiles\\default\\actionmaps.xml"
  },
  "actions": [
    { "id": "pitch", "label": "Pitch", "group": "Flight", "role": "pitch", "axis": true, "keys": [ "Mouse Y" ], "game": [ "v_pitch" ] },
    { "id": "roll", "label": "Roll", "group": "Flight", "role": "roll", "axis": true, "game": [ "v_roll" ] },
    { "id": "yaw", "label": "Yaw", "group": "Flight", "role": "yaw", "axis": true, "keys": [ "Mouse X" ], "game": [ "v_yaw" ] },
    { "id": "throttle", "label": "Throttle", "group": "Flight", "role": "throttle", "axis": true, "centred": false, "game": [ "v_throttle_abs" ] },
    { "id": "throttle_up", "label": "Throttle Up", "group": "Flight", "role": "throttle.up", "game": [ "v_throttle_up" ] },
    { "id": "throttle_down", "label": "Throttle Down", "group": "Flight", "role": "throttle.down", "game": [ "v_throttle_down" ] },
    { "id": "roll_left", "label": "Roll Left", "group": "Flight", "role": "roll.left", "keys": [ "Q" ], "game": [ "v_roll_left" ] },
    { "id": "roll_right", "label": "Roll Right", "group": "Flight", "role": "roll.right", "keys": [ "E" ], "game": [ "v_roll_right" ] },
    { "id": "pitch_up", "label": "Pitch Up", "group": "Flight", "role": "pitch.up", "game": [ "v_pitch_up" ] },
    { "id": "pitch_down", "label": "Pitch Down", "group": "Flight", "role": "pitch.down", "game": [ "v_pitch_down" ] },
    { "id": "yaw_left", "label": "Yaw Left", "group": "Flight", "role": "yaw.left", "game": [ "v_yaw_left" ] },
    { "id": "yaw_right", "label": "Yaw Right", "group": "Flight", "role": "yaw.right", "game": [ "v_yaw_right" ] },
    { "id": "strafe_left_right", "label": "Strafe Left/Right", "group": "Thrusters", "role": "strafe.x", "axis": true, "game": [ "v_strafe_lateral" ] },
    { "id": "strafe_up_down", "label": "Strafe Up/Down", "group": "Thrusters", "role": "strafe.y", "axis": true, "game": [ "v_strafe_vertical" ] },
    { "id": "forward_back", "label": "Forward/Back", "group": "Thrusters", "role": "thrust.z", "axis": true, "game": [ "v_strafe_longitudinal" ] },
    { "id": "strafe_left", "label": "Strafe Left", "group": "Thrusters", "role": "strafe.left", "keys": [ "A" ], "game": [ "v_strafe_left" ] },
    { "id": "strafe_right", "label": "Strafe Right", "group": "Thrusters", "role": "strafe.right", "keys": [ "D" ], "game": [ "v_strafe_right" ] },
    { "id": "strafe_up", "label": "Strafe Up", "group": "Thrusters", "role": "strafe.up", "keys": [ "Space" ], "game": [ "v_strafe_up" ] },
    { "id": "strafe_down", "label": "Strafe Down", "group": "Thrusters", "role": "strafe.down", "keys": [ "Left Ctrl" ], "game": [ "v_strafe_down" ] },
    { "id": "forward", "label": "Forward", "group": "Thrusters", "role": "thrust.forward", "keys": [ "W" ], "game": [ "v_strafe_forward" ] },
    { "id": "backward", "label": "Backward", "group": "Thrusters", "role": "thrust.back", "keys": [ "S" ], "game": [ "v_strafe_back" ] },
    { "id": "boost_afterburner", "label": "Boost (Afterburner)", "group": "Flight", "role": "boost", "keys": [ "Left Shift" ], "game": [ "v_afterburner" ] },
    { "id": "space_brake", "label": "Space Brake", "group": "Flight", "role": "wheelbrake", "keys": [ "X" ], "game": [ "v_space_brake" ] },
    { "id": "decoupled_mode", "label": "Decoupled Mode", "group": "Flight", "role": "flight.assist", "game": [ "v_ifcs_toggle_vector_decoupling" ] },
    { "id": "flight_ready", "label": "Flight Ready", "group": "Flight", "role": "engine.start", "keys": [ "R" ], "game": [ "v_flightready" ] },
    { "id": "landing_gear", "label": "Landing Gear", "group": "Flight", "role": "landing.gear", "keys": [ "N" ], "game": [ "v_toggle_landing_system" ] },
    { "id": "request_landing", "label": "Request Landing", "group": "Flight" },
    { "id": "quantum_travel_mode", "label": "Quantum Travel Mode", "group": "Flight", "keys": [ "B" ], "game": [ "v_toggle_qdrive_engagement" ] },
    { "id": "vtol", "label": "VTOL", "group": "Flight", "game": [ "v_ifcs_toggle_vtol" ] },
    { "id": "cruise_control", "label": "Cruise Control", "group": "Flight", "game": [ "v_ifcs_toggle_cruise_control" ] },
    { "id": "match_target_speed", "label": "Match Target Speed", "group": "Flight", "role": "match.speed", "game": [ "v_target_match_vel" ] },
    { "id": "fire_weapon_group_1", "label": "Fire Weapon Group 1", "group": "Weapons", "role": "fire.primary", "keys": [ "Mouse Left" ], "game": [ "v_attack1_group1" ] },
    { "id": "fire_weapon_group_2", "label": "Fire Weapon Group 2", "group": "Weapons", "role": "fire.secondary", "game": [ "v_attack1_group2" ] },
    { "id": "missile_operator_mode", "label": "Missile Operator Mode", "group": "Weapons", "role": "hardpoints", "keys": [ "Mouse Middle" ] },
    { "id": "launch_missile", "label": "Launch Missile", "group": "Weapons", "role": "fire.missile", "game": [ "v_weapon_launch_missile" ] },
    { "id": "launch_decoy", "label": "Launch Decoy", "group": "Weapons", "role": "countermeasure", "game": [ "v_weapon_countermeasure_decoy_launch" ] },
    { "id": "launch_noise", "label": "Launch Noise", "group": "Weapons", "game": [ "v_weapon_countermeasure_noise_launch" ] },
    { "id": "lock_target_ahead", "label": "Lock Target Ahead", "group": "Targeting", "role": "target.ahead" },
    { "id": "cycle_lock_targets", "label": "Cycle Lock Targets", "group": "Targeting", "role": "target.next" },
    { "id": "cycle_lock_back", "label": "Cycle Lock Back", "group": "Targeting", "role": "target.prev" },
    { "id": "cycle_hostile", "label": "Cycle Hostile", "group": "Targeting", "role": "target.hostile.next", "game": [ "v_target_cycle_hostile_fwd" ] },
    { "id": "lock_attacker", "label": "Lock Attacker", "group": "Targeting", "role": "target.attacker" },
    { "id": "cycle_subtargets", "label": "Cycle Subtargets", "group": "Targeting", "role": "target.subsystem.next", "game": [ "v_target_cycle_subitem_fwd" ] },
    { "id": "pin_target", "label": "Pin Target", "group": "Targeting", "role": "target.lock" },
    { "id": "power_to_engines", "label": "Power to Engines", "group": "Power", "role": "power.engines" },
    { "id": "power_to_weapons", "label": "Power to Weapons", "group": "Power", "role": "power.weapons" },
    { "id": "power_to_shields", "label": "Power to Shields", "group": "Power", "role": "power.shields" },
    { "id": "reset_power", "label": "Reset Power", "group": "Power", "role": "power.reset" },
    { "id": "lights", "label": "Lights", "group": "Systems", "role": "lights", "keys": [ "L" ], "game": [ "v_lights" ] },
    { "id": "scanning_mode", "label": "Scanning Mode", "group": "Systems", "keys": [ "V" ] },
    { "id": "free_look", "label": "Free Look", "group": "Views", "role": "look.free", "keys": [ "Left Alt" ], "game": [ "v_view_freelook_mode" ] },
    { "id": "change_camera", "label": "Change Camera", "group": "Views", "role": "camera.next", "keys": [ "F4" ], "game": [ "v_view_cycle_fwd" ] },
    { "id": "zoom", "label": "Zoom", "group": "Views", "role": "zoom" },
    { "id": "interact", "label": "Interact", "group": "Interface", "keys": [ "F" ] },
    { "id": "mobiglas", "label": "mobiGlas", "group": "Interface", "keys": [ "F1" ], "game": [ "ui_toggle_mobiglas" ] },
    { "id": "star_map", "label": "Star Map", "group": "Interface", "role": "map", "keys": [ "F2" ] },
    { "id": "recentre_vr", "label": "Recentre VR", "group": "Views", "role": "vr.recentre" }
  ]
}
