// Star Citizen. Binder keeps the bindings (format "sheet"): Star Citizen keeps its own in user\client\0\Profiles\default\actionmaps.xml
// (only what differs from its defaults). Defaults: the long-standing ones (W, A, S, D, Space and Left Ctrl to strafe, Q
// and E to roll, the mouse to aim, Left Shift boost, X the space brake, N the gear, R flight ready, F1 mobiGlas, F2 the
// star map); patches move some. Defaults are left out where they couldn't be checked; set them in the game, or add "keys" here.
{
  "id": "star-citizen",
  "name": "Star Citizen",
  "kind": "space",
  "format": "sheet",
  "folderHint": "Star Citizen's LIVE folder",
  "find": ["D:\\RSI\\StarCitizen\\LIVE", "%ProgramFiles%\\Roberts Space Industries\\StarCitizen\\LIVE", "C:\\RSI\\StarCitizen\\LIVE", "G:\\RSI\\StarCitizen\\LIVE"],
  "programs": ["StarCitizen"],
  "options": {
    "file": "user\\client\\0\\Profiles\\default\\actionmaps.xml"
  },
  "actions": [
    { "id": "pitch", "label": "Pitch", "group": "Flight", "role": "pitch", "axis": true, "keys": [ "Mouse Y" ] },
    { "id": "roll", "label": "Roll", "group": "Flight", "role": "roll", "axis": true },
    { "id": "yaw", "label": "Yaw", "group": "Flight", "role": "yaw", "axis": true, "keys": [ "Mouse X" ] },
    { "id": "throttle", "label": "Throttle", "group": "Flight", "role": "throttle", "axis": true, "centred": false },
    { "id": "throttle_up", "label": "Throttle Up", "group": "Flight", "role": "throttle.up" },
    { "id": "throttle_down", "label": "Throttle Down", "group": "Flight", "role": "throttle.down" },
    { "id": "roll_left", "label": "Roll Left", "group": "Flight", "role": "roll.left", "keys": [ "Q" ] },
    { "id": "roll_right", "label": "Roll Right", "group": "Flight", "role": "roll.right", "keys": [ "E" ] },
    { "id": "pitch_up", "label": "Pitch Up", "group": "Flight", "role": "pitch.up" },
    { "id": "pitch_down", "label": "Pitch Down", "group": "Flight", "role": "pitch.down" },
    { "id": "yaw_left", "label": "Yaw Left", "group": "Flight", "role": "yaw.left" },
    { "id": "yaw_right", "label": "Yaw Right", "group": "Flight", "role": "yaw.right" },
    { "id": "strafe_left_right", "label": "Strafe Left/Right", "group": "Thrusters", "role": "strafe.x", "axis": true },
    { "id": "strafe_up_down", "label": "Strafe Up/Down", "group": "Thrusters", "role": "strafe.y", "axis": true },
    { "id": "forward_back", "label": "Forward/Back", "group": "Thrusters", "role": "thrust.z", "axis": true },
    { "id": "strafe_left", "label": "Strafe Left", "group": "Thrusters", "role": "strafe.left", "keys": [ "A" ] },
    { "id": "strafe_right", "label": "Strafe Right", "group": "Thrusters", "role": "strafe.right", "keys": [ "D" ] },
    { "id": "strafe_up", "label": "Strafe Up", "group": "Thrusters", "role": "strafe.up", "keys": [ "Space" ] },
    { "id": "strafe_down", "label": "Strafe Down", "group": "Thrusters", "role": "strafe.down", "keys": [ "Left Ctrl" ] },
    { "id": "forward", "label": "Forward", "group": "Thrusters", "role": "thrust.forward", "keys": [ "W" ] },
    { "id": "backward", "label": "Backward", "group": "Thrusters", "role": "thrust.back", "keys": [ "S" ] },
    { "id": "boost_afterburner", "label": "Boost (Afterburner)", "group": "Flight", "role": "boost", "keys": [ "Left Shift" ] },
    { "id": "space_brake", "label": "Space Brake", "group": "Flight", "role": "wheelbrake", "keys": [ "X" ] },
    { "id": "decoupled_mode", "label": "Decoupled Mode", "group": "Flight", "role": "flight.assist" },
    { "id": "flight_ready", "label": "Flight Ready", "group": "Flight", "role": "engine.start", "keys": [ "R" ] },
    { "id": "landing_gear", "label": "Landing Gear", "group": "Flight", "role": "landing.gear", "keys": [ "N" ] },
    { "id": "request_landing", "label": "Request Landing", "group": "Flight" },
    { "id": "quantum_travel_mode", "label": "Quantum Travel Mode", "group": "Flight", "keys": [ "B" ] },
    { "id": "vtol", "label": "VTOL", "group": "Flight" },
    { "id": "cruise_control", "label": "Cruise Control", "group": "Flight" },
    { "id": "match_target_speed", "label": "Match Target Speed", "group": "Flight", "role": "match.speed" },
    { "id": "fire_weapon_group_1", "label": "Fire Weapon Group 1", "group": "Weapons", "role": "fire.primary", "keys": [ "Mouse Left" ] },
    { "id": "fire_weapon_group_2", "label": "Fire Weapon Group 2", "group": "Weapons", "role": "fire.secondary" },
    { "id": "missile_operator_mode", "label": "Missile Operator Mode", "group": "Weapons", "role": "hardpoints", "keys": [ "Mouse Middle" ] },
    { "id": "launch_missile", "label": "Launch Missile", "group": "Weapons", "role": "fire.missile" },
    { "id": "launch_decoy", "label": "Launch Decoy", "group": "Weapons", "role": "countermeasure" },
    { "id": "launch_noise", "label": "Launch Noise", "group": "Weapons" },
    { "id": "lock_target_ahead", "label": "Lock Target Ahead", "group": "Targeting", "role": "target.ahead" },
    { "id": "cycle_lock_targets", "label": "Cycle Lock Targets", "group": "Targeting", "role": "target.next" },
    { "id": "cycle_lock_back", "label": "Cycle Lock Back", "group": "Targeting", "role": "target.prev" },
    { "id": "cycle_hostile", "label": "Cycle Hostile", "group": "Targeting", "role": "target.hostile.next" },
    { "id": "lock_attacker", "label": "Lock Attacker", "group": "Targeting", "role": "target.attacker" },
    { "id": "cycle_subtargets", "label": "Cycle Subtargets", "group": "Targeting", "role": "target.subsystem.next" },
    { "id": "pin_target", "label": "Pin Target", "group": "Targeting", "role": "target.lock" },
    { "id": "power_to_engines", "label": "Power to Engines", "group": "Power", "role": "power.engines" },
    { "id": "power_to_weapons", "label": "Power to Weapons", "group": "Power", "role": "power.weapons" },
    { "id": "power_to_shields", "label": "Power to Shields", "group": "Power", "role": "power.shields" },
    { "id": "reset_power", "label": "Reset Power", "group": "Power", "role": "power.reset" },
    { "id": "lights", "label": "Lights", "group": "Systems", "role": "lights", "keys": [ "L" ] },
    { "id": "scanning_mode", "label": "Scanning Mode", "group": "Systems", "keys": [ "V" ] },
    { "id": "free_look", "label": "Free Look", "group": "Views", "role": "look.free", "keys": [ "Left Alt" ] },
    { "id": "change_camera", "label": "Change Camera", "group": "Views", "role": "camera.next", "keys": [ "F4" ] },
    { "id": "zoom", "label": "Zoom", "group": "Views", "role": "zoom" },
    { "id": "interact", "label": "Interact", "group": "Interface", "keys": [ "F" ] },
    { "id": "mobiglas", "label": "mobiGlas", "group": "Interface", "keys": [ "F1" ] },
    { "id": "star_map", "label": "Star Map", "group": "Interface", "role": "map", "keys": [ "F2" ] },
    { "id": "recentre_vr", "label": "Recentre VR", "group": "Views", "role": "vr.recentre" }
  ]
}
