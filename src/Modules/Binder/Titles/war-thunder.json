// War Thunder (aircraft). Binder keeps the bindings (format "sheet"): War Thunder keeps its own in its control presets (.blk). Defaults: depend on
// the preset the game was set up with (mouse aim: the left button fires). Defaults are left out where they couldn't be checked; set them in the game, or add "keys" here.
{
  "id": "war-thunder",
  "name": "War Thunder",
  "kind": "flight",
  "format": "sheet",
  "folderHint": "War Thunder's folder",
  "find": ["steam:War Thunder", "%LOCALAPPDATA%\\WarThunder", "documents:My Games\\WarThunder"],
  "programs": ["aces"],
  "options": {
    "file": "config.blk"
  },
  "actions": [
    { "id": "pitch", "label": "Pitch", "group": "Flight", "role": "pitch", "axis": true },
    { "id": "roll", "label": "Roll", "group": "Flight", "role": "roll", "axis": true },
    { "id": "yaw", "label": "Yaw", "group": "Flight", "role": "yaw", "axis": true },
    { "id": "throttle", "label": "Throttle", "group": "Flight", "role": "throttle", "axis": true, "centred": false },
    { "id": "throttle_up", "label": "Throttle Up", "group": "Flight", "role": "throttle.up" },
    { "id": "throttle_down", "label": "Throttle Down", "group": "Flight", "role": "throttle.down" },
    { "id": "roll_left", "label": "Roll Left", "group": "Flight", "role": "roll.left" },
    { "id": "roll_right", "label": "Roll Right", "group": "Flight", "role": "roll.right" },
    { "id": "pitch_up", "label": "Pitch Up", "group": "Flight", "role": "pitch.up" },
    { "id": "pitch_down", "label": "Pitch Down", "group": "Flight", "role": "pitch.down" },
    { "id": "yaw_left", "label": "Yaw Left", "group": "Flight", "role": "yaw.left" },
    { "id": "yaw_right", "label": "Yaw Right", "group": "Flight", "role": "yaw.right" },
    { "id": "fire_guns", "label": "Fire Guns", "group": "Weapons", "role": "fire.primary", "keys": [ "Mouse Left" ] },
    { "id": "fire_cannons", "label": "Fire Cannons", "group": "Weapons", "role": "fire.secondary" },
    { "id": "fire_rockets", "label": "Fire Rockets", "group": "Weapons", "role": "fire.missile" },
    { "id": "drop_bombs", "label": "Drop Bombs", "group": "Weapons", "role": "fire.bomb" },
    { "id": "countermeasures", "label": "Countermeasures", "group": "Weapons", "role": "countermeasure" },
    { "id": "lock_target", "label": "Lock Target", "group": "Targeting", "role": "target.lock" },
    { "id": "next_target", "label": "Next Target", "group": "Targeting", "role": "target.next" },
    { "id": "landing_gear", "label": "Landing Gear", "group": "Systems", "role": "landing.gear" },
    { "id": "flaps_down", "label": "Flaps Down", "group": "Systems", "role": "flaps.down" },
    { "id": "flaps_up", "label": "Flaps Up", "group": "Systems", "role": "flaps.up" },
    { "id": "air_brake", "label": "Air Brake", "group": "Systems", "role": "airbrake" },
    { "id": "wheel_brakes", "label": "Wheel Brakes", "group": "Systems", "role": "wheelbrake" },
    { "id": "engine_on_off", "label": "Engine On/Off", "group": "Systems", "role": "engine.start" },
    { "id": "wep", "label": "WEP", "group": "Systems", "role": "boost" },
    { "id": "trim_up", "label": "Trim Up", "group": "Systems", "role": "trim.up" },
    { "id": "trim_down", "label": "Trim Down", "group": "Systems", "role": "trim.down" },
    { "id": "free_look", "label": "Free Look", "group": "Views", "role": "look.free" },
    { "id": "zoom", "label": "Zoom", "group": "Views", "role": "zoom", "keys": [ "Mouse Right" ] },
    { "id": "change_camera", "label": "Change Camera", "group": "Views", "role": "camera.next" },
    { "id": "map", "label": "Map", "group": "Interface", "role": "map" },
    { "id": "recentre_vr", "label": "Recentre VR", "group": "Views", "role": "vr.recentre" }
  ]
}
