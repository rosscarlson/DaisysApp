// Elite Dangerous. The actions are the ones in the preset's own .binds file; the defaults the game's keyboard and mouse
// scheme. Groups by the actions' ids (first match wins), each in a context (the ship, the SRV, on foot...: bindings
// only conflict within one); labels and roles for the ones that matter.
{
  "id": "elite-dangerous",
  "name": "Elite Dangerous",
  "kind": "space",
  "format": "elite",
  "folderHint": "Elite Dangerous' Options\\Bindings folder",
  "find": ["%LOCALAPPDATA%\\Frontier Developments\\Elite Dangerous\\Options\\Bindings"],
  "programs": ["EliteDangerous64"],
  "options": {
    "schemes": "steam:Elite Dangerous\\Products\\elite-dangerous-odyssey-64\\ControlSchemes",
    "defaults": "KeyboardMouseOnly.binds"
  },
  "groups": [
    { "name": "Landing", "match": "_Landing$", "context": "Landing" },
    { "name": "Flight Alternate", "match": "Alternate", "context": "Alternate" },
    { "name": "On Foot", "match": "^Humanoid|_Humanoid$", "context": "On Foot" },
    { "name": "SRV", "match": "Buggy|^Steer|^DriveSpeed|^AutoBreak|^VerticalThrustersButton|^ToggleDriveAssist|^(In|De)creaseSpeedButton|^RecallDismissShip", "context": "SRV" },
    { "name": "Multicrew", "match": "^MultiCrew", "context": "Multicrew" },
    { "name": "Fighter Orders", "match": "^Order|^OpenOrders", "context": "Ship" },
    { "name": "Cameras", "match": "^(Cam|Vanity|FreeCam|MoveFreeCam|PitchCamera|YawCamera|RollCamera|ToggleFreeCam|ToggleRotationLock|FixCamera|QuitCamera|ToggleAdvanceMode|FStop|PhotoCamera)", "context": "Cameras" },
    { "name": "Exploration", "match": "^(Exploration|SAA)", "context": "Exploration" },
    { "name": "Interface", "match": "^(UI_|UIFocus|Focus|QuickComms|CycleNextPa|CyclePreviousPa|GalaxyMap|SystemMap|Pause|FriendsMenu|OpenCodex|ShowPGScore|PlayerHUDMode|HeadLook|HMDReset|MicrophoneMute)", "context": "Interface" },
    { "name": "Targeting", "match": "^(SelectTarget|CycleNextTarget|CyclePreviousTarget|CycleNextHostile|CyclePreviousHostile|CycleNextSubsystem|CyclePreviousSubsystem|SelectHighestThreat|TargetWingman|WingNavLock|TargetNextRouteSystem)", "context": "Ship" },
    { "name": "Weapons and Systems", "match": "^(PrimaryFire|SecondaryFire|CycleFireGroup|DeployHardpoint|ToggleButtonUpInput|DeployHeatSink|UseShieldCell|FireChaff|TriggerFieldNeutraliser|ChargeECM|WeaponColour|EngineColour|NightVision|TriggerColonisation|ShipSpotLight|Increase\\w*Power|ResetPowerDistribution|Radar|ToggleCargoScoop|EjectAllCargo|LandingGearToggle)", "context": "Ship" },
    { "name": "Flight Rotation", "match": "^(Yaw|Roll|Pitch)", "context": "Ship" },
    { "name": "Flight Thrust", "match": "Thrust|^SetSpeed|^ForwardKey|^BackwardKey|Throttle|^ToggleFlightAssist|^UseBoostJuice|^HyperSuperCombination|^Supercruise|^Hyperspace|^DisableRotationCorrect|^OrbitLines", "context": "Ship" },
    { "name": "Other", "match": ".", "context": "Other" }
  ],
  "actions": [
    { "id": "YawAxisRaw", "label": "Yaw Axis", "role": "yaw" },
    { "id": "YawLeftButton", "label": "Yaw Left", "role": "yaw.left" },
    { "id": "YawRightButton", "label": "Yaw Right", "role": "yaw.right" },
    { "id": "RollAxisRaw", "label": "Roll Axis", "role": "roll" },
    { "id": "RollLeftButton", "label": "Roll Left", "role": "roll.left" },
    { "id": "RollRightButton", "label": "Roll Right", "role": "roll.right" },
    { "id": "PitchAxisRaw", "label": "Pitch Axis", "role": "pitch" },
    { "id": "PitchUpButton", "label": "Pitch Up", "role": "pitch.up" },
    { "id": "PitchDownButton", "label": "Pitch Down", "role": "pitch.down" },
    { "id": "LateralThrustRaw", "label": "Lateral Thrust Axis", "role": "strafe.x" },
    { "id": "LeftThrustButton", "label": "Thrust Left", "role": "strafe.left" },
    { "id": "RightThrustButton", "label": "Thrust Right", "role": "strafe.right" },
    { "id": "VerticalThrustRaw", "label": "Vertical Thrust Axis", "role": "strafe.y" },
    { "id": "UpThrustButton", "label": "Thrust Up", "role": "strafe.up" },
    { "id": "DownThrustButton", "label": "Thrust Down", "role": "strafe.down" },
    { "id": "AheadThrust", "label": "Forward Thrust Axis", "role": "thrust.z" },
    { "id": "ForwardThrustButton", "label": "Thrust Forward", "role": "thrust.forward" },
    { "id": "BackwardThrustButton", "label": "Thrust Backward", "role": "thrust.back" },
    { "id": "ThrottleAxis", "label": "Throttle Axis", "role": "throttle", "centred": false },
    { "id": "ForwardKey", "label": "Increase Throttle", "role": "throttle.up" },
    { "id": "BackwardKey", "label": "Decrease Throttle", "role": "throttle.down" },
    { "id": "SetSpeedZero", "label": "Set Speed to 0%", "role": "throttle.zero" },
    { "id": "SetSpeed100", "label": "Set Speed to 100%", "role": "throttle.max" },
    { "id": "UseBoostJuice", "label": "Engine Boost", "role": "boost" },
    { "id": "ToggleFlightAssist", "label": "Flight Assist", "role": "flight.assist" },
    { "id": "SelectTarget", "label": "Select Target Ahead", "role": "target.ahead" },
    { "id": "CycleNextTarget", "label": "Next Target", "role": "target.next" },
    { "id": "CyclePreviousTarget", "label": "Previous Target", "role": "target.prev" },
    { "id": "SelectHighestThreat", "label": "Highest Threat", "role": "target.attacker" },
    { "id": "CycleNextHostileTarget", "label": "Next Hostile", "role": "target.hostile.next" },
    { "id": "CyclePreviousHostileTarget", "label": "Previous Hostile", "role": "target.hostile.prev" },
    { "id": "SelectTargetsTarget", "label": "Target's Target", "role": "target.targets.target" },
    { "id": "CycleNextSubsystem", "label": "Next Subsystem", "role": "target.subsystem.next" },
    { "id": "CyclePreviousSubsystem", "label": "Previous Subsystem", "role": "target.subsystem.prev" },
    { "id": "PrimaryFire", "label": "Primary Fire", "role": "fire.primary" },
    { "id": "SecondaryFire", "label": "Secondary Fire", "role": "fire.secondary" },
    { "id": "CycleFireGroupNext", "label": "Next Fire Group", "role": "weapon.next" },
    { "id": "CycleFireGroupPrevious", "label": "Previous Fire Group", "role": "weapon.prev" },
    { "id": "FireChaffLauncher", "label": "Chaff", "role": "countermeasure" },
    { "id": "IncreaseEnginesPower", "label": "Power to Engines", "role": "power.engines" },
    { "id": "IncreaseWeaponsPower", "label": "Power to Weapons", "role": "power.weapons" },
    { "id": "IncreaseSystemsPower", "label": "Power to Systems", "role": "power.shields" },
    { "id": "ResetPowerDistribution", "label": "Balance Power", "role": "power.reset" },
    { "id": "GalaxyMapOpen", "label": "Galaxy Map", "role": "map" },
    { "id": "HeadLookToggle", "label": "Head Look", "role": "look.free" },
    { "id": "HeadLookReset", "label": "Reset Head Look", "role": "look.centre" },
    { "id": "Pause", "role": "pause" },
    { "id": "PlayerHUDModeToggle", "label": "HUD Mode", "role": "hud" },
    { "id": "LandingGearToggle", "label": "Landing Gear", "role": "landing.gear" },
    { "id": "ShipSpotLightToggle", "label": "Ship Lights", "role": "lights" },
    { "id": "RadarIncreaseRange", "label": "Radar Range Up", "role": "radar.range" },
    { "id": "DeployHardpointToggle", "label": "Hardpoints", "role": "hardpoints" },
    { "id": "MouseReset", "hidden": true },
    { "id": "BlockMouseDecay", "hidden": true }
  ]
}
