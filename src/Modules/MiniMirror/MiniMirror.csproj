<Project Sdk="Microsoft.NET.Sdk">
  <!-- See ../Directory.Build.props and ../Template/README.md -->
  <PropertyGroup>
    <!-- Screen.AllScreens for the monitor layout -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <!-- WinForms is only used for the screen list; keep its namespaces out of the global usings (WPF name clashes) -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
