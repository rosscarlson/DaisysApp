<UserControl x:Class="DaisysApp.Applets.Sensors.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
            <!-- shown while LibreHardwareMonitor isn't answering -->
            <Border x:Name="SensorBanner" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Setup_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{l:Tr 'Get more sensor data…'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="SensorBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                </DockPanel>
            </Border>

            <!-- every sensor LibreHardwareMonitor reports, grouped by hardware (built in code) -->
            <Border x:Name="SensorCard" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                   Text="{l:Tr 'from LibreHardwareMonitor · min and max since it started'}"/>
                        <TextBlock Text="{l:Tr 'Hardware sensors'}" Style="{StaticResource CardHeader}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel x:Name="SensorFilters" Margin="0,0,0,12"/>
                    <WrapPanel x:Name="SensorGroups"/>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{l:Tr 'Click a sensor for its graph, or a hardware name for all of its sensors of this kind together. Temperatures, fans and power are kept in the log; the others are live only.'}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
