<Window x:Class="DaisysApp.Applets.Sensors.SensorSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core"
        Title="{l:Tr 'More sensor data'}" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <Style x:Key="Step" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style x:Key="Number" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{l:Tr 'Get more sensor data'}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                   Text="{l:Tr 'Windows only lets programs read the CPU\'s, motherboard\'s, memory\'s and drives\' sensors through a hardware driver. LibreHardwareMonitor is a free, open-source monitor with that driver; while it runs, Daisy\'s App reads its numbers and adds:'}"/>
        <TextBlock Margin="12,10,0,0" TextWrapping="Wrap" LineHeight="21"><Run Text="{l:Tr '• CPU temperature and power on the Temperatures tile, and in the log'}"/><LineBreak/><Run Text="{l:Tr '• Motherboard, memory, drive and GPU hot-spot temperatures'}"/><LineBreak/><Run Text="{l:Tr '• Fan speeds, voltages, power, clocks and more in a Hardware sensors section'}"/></TextBlock>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <DockPanel>
                    <Border Style="{StaticResource Number}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold"/></Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Step}" Text="{l:Tr 'Download LibreHardwareMonitor (the .zip from the latest release).'}"/>
                        <Button HorizontalAlignment="Left" Click="Download_Click" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:Tr 'Open the download page'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <Border Style="{StaticResource Number}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold"/></Border>
                    <TextBlock Style="{StaticResource Step}" Text="{l:Tr 'Unzip it to a folder it can stay in, and run LibreHardwareMonitor.exe. Windows asks for administrator approval: it needs that to read the sensors.'}"/>
                </DockPanel>
                <DockPanel>
                    <Border Style="{StaticResource Number}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold"/></Border>
                    <!-- one line: whitespace between the runs would show as spaces -->
                    <TextBlock Style="{StaticResource Step}"><Run Text="{l:Tr 'In LibreHardwareMonitor: '}"/><Run FontWeight="SemiBold" Text="Options → Remote Web Server → Run"/><Run Text="{l:Tr '. It uses port 8085; if you change it, set the same address in Settings → Performance.'}"/></TextBlock>
                </DockPanel>
                <DockPanel>
                    <Border Style="{StaticResource Number}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold"/></Border>
                    <TextBlock Style="{StaticResource Step}" Margin="0"><Run Text="{l:Tr 'So it\'s always there: '}"/><Run FontWeight="SemiBold" Text="Options → Run On Windows Startup"/><Run Text=", "/><Run FontWeight="SemiBold" Text="Start Minimized"/><Run Text="{l:Tr ' and '}"/><Run FontWeight="SemiBold" Text="Minimize To Tray"/><Run Text="."/></TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Close'}" MinWidth="90" Click="Close_Click" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Check again'}" MinWidth="110" Margin="0,0,8,0" Click="Check_Click"/>
            <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0" Fill="{DynamicResource ControlBorderBrush}"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,12,0"/>
        </DockPanel>
    </StackPanel>
</Window>
