<UserControl x:Class="DaisysApp.Applets.UsbMonitor.UsbMonitorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l:Tr 'Event log'}" Style="{StaticResource CardHeader}"/>
                <CheckBox x:Name="LogBox" Content="{l:Tr 'Write every event to a log file'}"
                          Checked="LogBox_Changed" Unchecked="LogBox_Changed"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="26,6,0,0"
                           Text="{l:Tr 'A new tab-delimited file starts each time the app launches, and every event is saved as it happens, so a crash doesn\'t lose data. Old files stay in the log folder until you delete them.'}"/>
                <TextBlock x:Name="LogFileText" Margin="26,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <Button Content="{l:Tr 'Open log folder'}" HorizontalAlignment="Left" Margin="26,10,0,0" Click="OpenFolder_Click"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l:Tr 'Monitoring'}" Style="{StaticResource CardHeader}"/>
                <TextBlock Style="{StaticResource SecondaryText}"
                           Text="{l:Tr 'Devices are monitored for as long as Daisy\'s App is running, including while it\'s in the system tray or another tab is open. To catch a device that misbehaves when you\'re not looking, keep the app in the tray and start it at sign-in (Settings → General).'}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
