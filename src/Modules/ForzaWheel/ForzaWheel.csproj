<Project Sdk="Microsoft.NET.Sdk">
  <!-- See ../Directory.Build.props and ../Template/README.md. ForzaWheel: a wheel, pedals, shifter and button boxes as
       one vJoy controller, for Forza. In Daisy's App it shares the Gaming tab with Joy2Key (the tab is described in
       ../Joy2Key/GamingTab.cs, linked here). -->
  <ItemGroup>
    <!-- reads wheels, pedals, shifters and button boxes (up to 8 axes, 128 buttons and 4 hats each) -->
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
    <Compile Include="..\Joy2Key\GamingTab.cs" Link="GamingTab.cs" />
  </ItemGroup>
</Project>
