<UserControl x:Class="DaisysApp.Applets.Template.TemplateSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core">
    <!-- Settings → Template: a module's settings page is any element; the app puts it under its own sub-tab. -->
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l:Tr 'Greeting'}" Style="{StaticResource CardHeader}"/>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{l:Tr 'Say hello to'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="NameBox" Width="200" TextChanged="NameBox_TextChanged"/>
                </DockPanel>
                <Button Content="{l:Tr 'Reset the click count'}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Reset_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
