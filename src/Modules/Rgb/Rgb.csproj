<Project Sdk="Microsoft.NET.Sdk">
  <!-- See ../Directory.Build.props and ../Template/README.md. RGB: the lights on the motherboard (and its fan headers),
       RAM and graphics card, set without the makers' programs (ASUS Aura over USB HID, the graphics card's I2C through
       NVIDIA's driver, the SMBus through PawnIO). In Daisy's App it shares the Gaming tab (../Joy2Key/GamingTab.cs, linked here). -->
  <ItemGroup>
    <Compile Include="..\Joy2Key\GamingTab.cs" Link="GamingTab.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- PawnIO's signed SMBus modules (namazso/PawnIO.Modules 0.2.11, LGPL-2.1, unchanged), loaded into the PawnIO driver for the RAM -->
    <None Include="PawnIO\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
