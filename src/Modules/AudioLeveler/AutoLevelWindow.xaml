<Window x:Class="DaisysApp.Applets.AudioLevel.AutoLevelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DaisysApp;assembly=DaisysApp.Core"
        Title="{l:Tr 'Auto-level speakers'}" Width="760" MinWidth="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,20">
        <TextBlock Text="{l:Tr 'Auto-level speakers'}" FontSize="20" FontWeight="SemiBold"/>

        <Border Style="{StaticResource Card}" Margin="0,14,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{l:Tr 'Output'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,6"/>
                <TextBlock x:Name="OutputText" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Text="{l:Tr 'Levels saved in'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                <TextBlock x:Name="SavedInText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="MicLevelText" DockPanel.Dock="Right" MinWidth="90" TextAlignment="Right" FontWeight="SemiBold" Text="—"/>
                    <TextBlock Text="{l:Tr 'Microphone'}" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <ComboBox x:Name="MicBox" DisplayMemberPath="Display" Margin="0,4,0,10" SelectionChanged="MicBox_SelectionChanged"/>
                <Border Height="8" CornerRadius="4" Background="{DynamicResource ControlBorderBrush}" ClipToBounds="True">
                    <Border x:Name="MicBar" CornerRadius="4" Background="{DynamicResource SuccessBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="MicBarScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <Grid x:Name="MicGainRow" Margin="0,12,0,0"
                      ToolTip="{l:Tr 'The microphone\'s input volume in Windows (Sound settings → Input → Volume).'}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr 'Mic level'}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Slider x:Name="MicGainSlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100"
                            SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="MicGainSlider_ValueChanged"/>
                    <TextBlock x:Name="MicGainText" Grid.Column="2" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,10">
            <StackPanel>
                <!-- column headers; widths match the row template below -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr 'Speaker'}" Style="{StaticResource ColHeader}" TextAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{l:Tr 'Baseline'}" Style="{StaticResource ColHeader}"/>
                    <TextBlock Grid.Column="2" Text="{l:Tr 'Leveling'}" Style="{StaticResource ColHeader}"/>
                    <TextBlock Grid.Column="3" Text="{l:Tr 'Verifying'}" Style="{StaticResource ColHeader}"/>
                    <TextBlock Grid.Column="4" Text="{l:Tr 'Level'}" Style="{StaticResource ColHeader}"/>
                </Grid>
                <ItemsControl x:Name="RowList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBorder" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="96"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Content="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Pass1}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Pass2}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Pass3}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding After}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                           Text="{l:Tr 'Baseline, Leveling and Verifying show each speaker as measured at the microphone (relative, not calibrated SPL). Level is the speaker\'s level setting.'}"/>
            </StackPanel>
        </Border>

        <!-- progress + status -->
        <Border Height="8" CornerRadius="4" Background="{DynamicResource ControlBorderBrush}" ClipToBounds="True" Margin="0,0,0,10">
            <Border CornerRadius="4" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                </Border.RenderTransform>
            </Border>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                           Text="{l:Tr 'Keep the room quiet while it runs · Esc cancels and puts the levels back'}"/>
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" Content="{l:Tr 'Close'}" MinWidth="80" Margin="16,0,8,0" Click="CloseButton_Click"/>
            <Button x:Name="StartButton" Grid.Column="2" Style="{StaticResource AccentButton}" MinWidth="136" MinHeight="42" Click="StartButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StartIcon" FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StartLabel" Text="{l:Tr 'Start'}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</Window>
