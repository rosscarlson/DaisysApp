<Project Sdk="Microsoft.NET.Sdk">
  <!-- See ../Directory.Build.props and ../Template/README.md. SimEffects: what SimHub does, tool by tool: the Shaker
       (BassShaker/), Arduinos (Arduino/) and their lights (Notify/), a Fanatec or Moza wheel's LEDs (Wheel/), screens' colours on Govee lights (AmbiLight/), the pedals and wheel over the game (InputOverlay/), the car, tyres and laps (Analysis/); the games'
       telemetry (Telemetry/) and the shift lights' logic (Lights/) they share. -->
  <ItemGroup>
    <!-- the games' telemetry, which every tool reads (Telemetry/) -->
    <Using Include="DaisysApp.Applets.SimEffects.Telemetry" />
    <!-- Forza's cars by number, per game (Telemetry/CarNames.cs) -->
    <EmbeddedResource Include="Telemetry\Cars.json" LogicalName="DaisysApp.SimEffects.Cars.json" />
    <!-- the profiles and Shaker effects a new install starts with (Profiles/SimDefaults.cs) -->
    <EmbeddedResource Include="Profiles\Defaults.json" LogicalName="DaisysApp.SimEffects.Defaults.json" />
    <!-- the FH5 and FH6 tracks the app comes with (Analysis/KnownTracks.cs) -->
    <EmbeddedResource Include="Analysis\Tracks.json" LogicalName="DaisysApp.SimEffects.Tracks.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- the audio devices (copied into the module's folder, with NAudio) -->
    <ProjectReference Include="..\..\DaisysApp.Shared\DaisysApp.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Input Overlay's controllers, from the one controller list every module shares (copied into the module's folder),
         read as ForzaWheel reads them (its files linked; Set is its Capture) -->
    <ProjectReference Include="..\..\DaisysApp.Controllers\DaisysApp.Controllers.csproj" />
    <Using Include="DaisysApp.Controllers" />
  </ItemGroup>
  <ItemGroup>
    <!-- AmbiLight's screen capture (desktop duplication; the same versions as Video's) -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <!-- Analysis' race videos, read frame by frame (Analysis/Sessions/VideoFrames.cs; the same version as Video's) -->
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- the Arduino sketch, next to the module (the Arduino tab's Open Sketch Folder) -->
    <None Include="Arduino\DaisysSim\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
